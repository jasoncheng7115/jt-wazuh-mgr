{
 "pack": "jt-linux-integrity",
 "fim_cases_note": "fim cases: syscheck events sent to the sandbox analysisd queue (tools/pack_sandbox.py). Paths and diffs are synthesized from the file formats (passwd(5), group(5), sudoers(5), pam.d(5)) and from paths seen on a site over 30 days; account names are placeholders.",
 "cases": [
  {
   "fim": {
    "path": "/etc/passwd",
    "type": "modified"
   },
   "expect_rule": "132910",
   "expect_level": 6,
   "note": "fim: passwd changed, no whodata (realtime only, the common case)"
  },
  {
   "fim": {
    "path": "/etc/passwd",
    "type": "modified",
    "process": "/usr/bin/vim.basic"
   },
   "expect_rule": "132912",
   "expect_level": 12,
   "note": "fim: passwd written by an editor"
  },
  {
   "fim": {
    "path": "/etc/passwd",
    "type": "modified",
    "process": "/usr/sbin/useradd"
   },
   "expect_rule": "132914",
   "expect_level": 3,
   "note": "fim: near miss: passwd written by useradd"
  },
  {
