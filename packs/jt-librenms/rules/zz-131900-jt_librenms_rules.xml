  </rule>

  <rule id="131969" level="6">
    <if_sid>31100,31108,31530</if_sid>
    <protocol type="pcre2">^(?:PUT|DELETE)$</protocol>
    <url type="pcre2">^/settings/[\w.-]+$</url>
    <id type="pcre2">^2</id>
    <description>LibreNMS: global setting changed or reset ($(url)) from $(srcip)</description>
