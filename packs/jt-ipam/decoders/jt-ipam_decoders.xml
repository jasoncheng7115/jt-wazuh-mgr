<!--
  jt-ipam: decoders
  Copyright Jason Tools Co., Ltd. / AGPL-3.0-or-later

  jt-ipam writes two kinds of records, and the pack reads two more sources
  on the jt-ipam host (3 and 4):

  1. Service messages on stdout, which systemd puts in the journal as
     jt-ipam-backend, jt-ipam-sync and jt-ipam-backup. A Linux agent that reads
     journald (or /var/log/syslog) already sends them.
  2. The audit trail. jt-ipam keeps it in its database (a SHA-256 hash chain)
     and forwards each record as one GELF message (JSON). The pack's setup
     guide has rsyslog on the jt-ipam host write each message as a syslog line
     with the program name jt-ipam-audit, which the jt-ipam agent group reads.
  3. guacd, the console engine (journal, program guacd): own decoder below.
  4. PostgreSQL's log, which the jt-ipam agent group reads from 1.2 on, for
     refused changes to the audit table: own decoder below.
  The web server's access and error logs use Wazuh's built-in decoders.

  Wazuh's built-in FreeIPA decoder matches program_name "ipa" ANYWHERE in the
  name, so it claims all four programs before any decoder of ours could.
  Without this file every jt-ipam line ends at the FreeIPA grouping rule 82202,
  level 0, with nothing decoded. These decoders are therefore children of
  "freeipa". Three things measured on 4.14.7 shape this file:
    - program_name is not evaluated on a child decoder: a child limited to one
      program also decodes the lines of every other program under the same
      parent. The rules check the program name instead.
    - A second family of children (a different decoder name) under the same
      parent is never reached once a family without a prematch exists. So all
      jt-ipam children are one family, the siblings below; every sibling
      applies on its own and adds its fields when its regex matches.
    - Audit records sent as bare JSON lines would be decoded by the built-in
      "json" decoder, and then generic syslog rules such as 1002 or 1007 take
      them whenever the record's free text contains "failed" or "No space left
      on device". Lines under the FreeIPA decoder do not have this problem,
      which is why the relay gives the audit lines a program name.
-->

<!--
  Service messages, e.g.
    jt-ipam-backend  {"method": "POST", "path": "/api/v1/auth/login", "status": 401, ...,
                      "client_ip": "192.0.2.10", "event": "request", ...}
                     {"event": "rdp: ws ... host=198.51.100.5 engine=guacd user=(uuid)", ...}
                     uvicorn also prints its own access line for each request
                     ("INFO:     192.0.2.10:0 - ..."); it carries nothing more.
    jt-ipam-sync     2026-10-09 02:01:17,301 [INFO] asyncssh: [conn=0] Auth for user root succeeded
  client_ip is the address nginx saw (uvicorn trusts only the local proxy for
  the forwarded address), so it is decoded as srcip. An IPv4-mapped prefix
  (::ffff:) is stripped so that IPv4 networks match. The IPv6 loopback ::1 is
  not decoded as srcip: on 4.14.7 a rule condition <srcip>::1</srcip> matched
  every IPv4 address in the sandbox, so ::1 cannot be listed among the private
  networks, and a ::1 source would otherwise count as an outside address.
-->
<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">^\{"method": "(\w+)", "path": "([^"]*)", "status": (\d+),</regex>
  <order>protocol, url, id</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">"client_ip": "(?:::ffff:)?(?!::1")([^"]+)"</regex>
  <order>srcip</order>
</decoder>

<!-- Outgoing HTTP requests of the integrations (httpx):
     HTTP Request: GET https://dc1.example.com/univention/udm/dns/... "HTTP/1.1 200 OK"
     In the backend's JSON the closing quotes are escaped. -->
<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">HTTP Request: (\w+) (\S+) \\?"HTTP/[\d.]+ (\d+)</regex>
  <order>protocol, url, id</order>
</decoder>

<!-- Remote host named in console and SSH messages. -->
<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">(?:host=|on host |Opening SSH connection to )([^\s",]+)</regex>
  <order>jtipam.host</order>
</decoder>

<!-- Account on the remote host, from asyncssh (console SSH and integrations). -->
<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">(?:Auth for user |Permission denied for user )(\S*?)(?: succeeded| on host)</regex>
  <order>dstuser</order>
</decoder>

<!-- The jt-ipam account (an id) in console messages: "user=" and a UUID. -->
<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">user=([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})</regex>
  <order>jtipam.actor_id</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">peer=(\d+)</regex>
  <order>jtipam.peer</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">code=([\w.-]+)</regex>
  <order>jtipam.code</order>
</decoder>

<!--
  Audit records, one GELF message after the syslog header, e.g.
    Oct 11 10:55:39 ipam-example jt-ipam-audit: {"version": "1.1", "host": "ipam-example",
     "short_message": "audit login_failed auth/...", "level": 6, "_app": "jt-ipam",
     "_action": "login_failed", "_object_type": "auth", "_object_id": "...",
     "_actor_user_id": "...", "_actor_ip": "192.0.2.10", "_request_id": "...",
     "_ts": "...", "_this_hash": "...", "_prev_hash": "...",
     "_diff": "{\"username\": \"alice\", \"realm\": \"local\", ...}"}
  The JSON plugin decodes every field (_action, _object_type, _actor_user_id,
  _diff ...). It also decodes the backend's JSON service lines, which is
  harmless. _diff is an object serialised as a string, so the plugin keeps it
  as one string; the siblings after it pick the parts rules need out of the
  raw line, where its quotes appear escaped as \".
  fts (first time seen) is not available: Wazuh accepts it only on the first
  decoder of a same-name family and, on a child of the FreeIPA decoder, it never
  fired in the sandbox (4.14.7); on any other sibling analysisd refuses it
  (error 2103). The rules use account names and source networks instead.
  _actor_user_id is the acting account's id: jt-ipam does not record the
  actor's name. "username" in _diff is the account the event is about (the
  one logging in, the one added to a role, or the account used on the remote
  host of a console session) and is decoded as dstuser.
-->
<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">"_actor_ip": "(?:::ffff:)?(?!::1")([^"]+)"</regex>
  <order>srcip</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"username\\": \\"([^\\"]+)\\"</regex>
  <order>dstuser</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"reason\\": \\"([^\\"]+)\\"</regex>
  <order>jtipam.reason</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"host\\": \\"([^\\"]+)\\"</regex>
  <order>jtipam.host</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"path\\": \\"([^\\"]+)\\"</regex>
  <order>jtipam.path</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"(?:setting|target)\\": \\"([^\\"]+)\\"</regex>
  <order>jtipam.setting</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"(?:name|label)\\": \\"([^\\"]+)\\"</regex>
  <order>jtipam.name</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"group\\": \\"([^\\"]+)\\"</regex>
  <order>jtipam.group</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"part\\": \\"([^\\"]+)\\"</regex>
  <order>jtipam.part</order>
</decoder>

<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"peer_id\\": \\"(\d+)\\"</regex>
  <order>jtipam.peer</order>
</decoder>

<!-- The target of a console session in one field: the remote host of an SSH,
     RDP, VNC, noVNC, BMC or SFTP session, or the peer ID of a RustDesk
     session. Counted by the "one account, many targets" rule. -->
<decoder name="jt-ipam">
  <parent>freeipa</parent>
  <regex type="pcre2">\\"(?:host|peer_id)\\": \\"([^\\"]+)\\"</regex>
  <order>jtipam.target</order>
</decoder>

<!--
  guacd (Apache Guacamole's proxy daemon), the console engine jt-ipam runs as
  the jt-ipam-guacd service. Its program name has no built-in decoder.
  guacd writes every message twice (guacamole-server 1.6.0, src/guacd/log.c,
  vguacd_log): once to syslog ("Joining existing connection ...") and once to
  stderr, which systemd also puts in the journal with the prefix
  "guacd[<pid>]: INFO:<tab>". Both copies were found in the journal of one
  installation. The rules read the syslog copy only, so each event alerts
  once. Format strings: src/guacd/connection.c ("Joining existing connection
  \"%s\"", "Connection \"%s\" does not exist").
-->
<decoder name="jt-ipam-guacd">
  <program_name type="pcre2">^guacd$</program_name>
</decoder>

<decoder name="jt-ipam-guacd-fields">
  <parent>jt-ipam-guacd</parent>
  <regex type="pcre2">[Cc]onnection "([^"]*)"</regex>
  <order>jtipam.connection</order>
</decoder>

<!--
  PostgreSQL's own log, as Debian and Ubuntu write it by default
  (log_line_prefix '%m [%p] %q%u@%d '), e.g.
    2026-09-23 06:12:13.835 UTC [1750547] jt_ipam@jt_ipam ERROR:  audit_logs is append-only: UPDATE is not allowed (id=4411)
    2026-10-03 16:04:31.567 UTC [426] LOG:  checkpoint starting: time
  The built-in PostgreSQL decoder expects a bracketed timestamp and takes
  none of these lines; the pre-decoder leaves them whole (4.14.7). The user
  name in the prefix is whatever a client sent, so it may hold spaces or an
  "@": the rules anchor on the end of the message, not only on the prefix.
-->
<decoder name="jt-ipam-pgsql">
  <prematch type="pcre2">^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d(?:\.\d+)? \S+ \[\d+\] </prematch>
</decoder>

<decoder name="jt-ipam-pgsql-fields">
  <parent>jt-ipam-pgsql</parent>
  <regex type="pcre2">^\S+ \S+ \S+ \[(\d+)\] (?:(.*?)@(\S*) )?([A-Z]+):  </regex>
  <order>jtipam.pg_pid, dstuser, jtipam.database, jtipam.pg_severity</order>
</decoder>
