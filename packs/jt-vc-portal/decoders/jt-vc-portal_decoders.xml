<!--
  jt-vc-portal decoders
  Copyright Jason Tools Co., Ltd. / AGPL-3.0-or-later

  jt-vc-portal is a meeting portal for 8x8 JaaS and self-hosted Jitsi Meet. In
  its logs it calls itself jaas-auth. It writes one audit record per action to
  audit-log.jsonl in its data directory, and can also send each record to one
  collector as RFC 5424 syslog, CEF or GELF. Every shape is decoded into the
  same names, so one set of rules serves all of them:

    action          static field: login, login_fail, settings_update, ...
    actor           the acting account (the typed name for a failed login,
                    the guest's display name for guest_join, system or cli
                    for jobs); also as user (static) where a first-seen
                    check needs it
    ip              the client address the portal recorded; also as srcip
                    (static, without an IPv4-mapped ::ffff: prefix) where the
                    shape carries one
    detail, result, role   as the portal writes them (role: JSON only)

  1. The audit file through the agent group jt-vc-portal (primary). The group
     sends every line with the prefix "jt-vc-portal: " (localfile out_format),
     and this decoder takes that shape. Why the prefix (measured on 4.14.7):
     a bare JSON line is taken by the built-in "json" decoder, which cannot
     produce srcip or carry a first-seen key, and a child decoder of "json" is
     not an option: once "json" has any child, every other JSON event on the
     manager loses its fields (a Suricata alert fell to rule 1002).
     The first-seen key (fts) sits on the parent, which therefore has a regex
     of its own: 4.14 refuses fts on a decoder without one, on a decoder with
     siblings of the same name, and on dynamic fields. The fields are read by
     regular expressions, not by the JSON plugin: with a JSON plugin child the
     first-seen check never fired (measured; without it, it does). The
     portal writes its keys in a fixed order, and every expression is anchored
     on the structural neighbours of its key; a quote inside a value is always
     escaped, so a detail or a guest name cannot imitate them. Values keep
     their JSON escapes.

     Bare JSON lines, collected without the prefix (log_format json), are still
     decoded by the built-in json decoder and still match the rules, without
     srcip and without the first-seen check.

  2. RFC 5424 syslog (export format "syslog"):
       1 2026-10-11T09:00:00+00:00 vc1 jaas-auth - - - audit login_fail actor=jdoe Attempted account: jdoe
     The manager removes the priority prefix. Wazuh has no RFC 5424 support:
     the line keeps its version digit and nothing is pre-decoded, so the
     prematch sees the whole line. The record carries no address, result or
     role. An actor with a space in it (a guest name) is cut at the space.

  3. CEF (export format "cef"), sent without any syslog header:
       CEF:0|JT|jaas-auth|1.0|login_fail|audit login_fail actor=jdoe ...|6|src=192.0.2.10 suser=jdoe outcome=fail requestClientApplication=...
     The extension escapes "=" inside values as "\=", and the header escapes
     "|" as "\|", so an unescaped "|severity|" and an unescaped "key=" can
     only be structure. Every extension field is read from the severity field
     onward (src, suser, outcome are written in that order), never from the
     header text or the user agent, both of which a client controls.

  GELF, the third export format, cannot be received by Wazuh.

  Measured: when a sibling's regex does not match (a record without an
  address), the siblings after it are still applied. The first sibling of
  each set always matches.
-->

<!-- 1. The audit file, prefixed by the agent group. -->
<decoder name="jt-vc-portal">
  <prematch>^jt-vc-portal:</prematch>
  <regex type="pcre2">,"actor":"((?:[^"\\]|\\.)*)","actor_name":"</regex>
  <order>user</order>
  <fts>name, user, srcip</fts>
</decoder>

<decoder name="jt-vc-portal-fields">
  <parent>jt-vc-portal</parent>
  <regex type="pcre2">^jt-vc-portal: {"ts":\d+,"time":"[^"]*","action":"([a-z0-9_]+)","detail":"</regex>
  <order>action</order>
</decoder>

<decoder name="jt-vc-portal-fields">
  <parent>jt-vc-portal</parent>
  <regex type="pcre2">,"action":"[a-z0-9_]+","detail":"((?:[^"\\]|\\.)*)","actor":"</regex>
  <order>detail</order>
</decoder>

<decoder name="jt-vc-portal-fields">
  <parent>jt-vc-portal</parent>
  <regex type="pcre2">,"actor":"((?:[^"\\]|\\.)*)","actor_name":"</regex>
  <order>actor</order>
</decoder>

<decoder name="jt-vc-portal-fields">
  <parent>jt-vc-portal</parent>
  <regex type="pcre2">,"actor":"((?:[^"\\]|\\.)*)","actor_name":"</regex>
  <order>user</order>
</decoder>

<decoder name="jt-vc-portal-fields">
  <parent>jt-vc-portal</parent>
  <regex type="pcre2">,"role":"([a-z]*)","result":"([a-z]*)","ip":"([0-9A-Fa-f.:]*)","user_agent":"</regex>
  <order>role, result, ip</order>
</decoder>

<decoder name="jt-vc-portal-fields">
  <parent>jt-vc-portal</parent>
  <regex type="pcre2">,"result":"[a-z]*","ip":"(?:::ffff:)?([0-9A-Fa-f.:]+)","user_agent":"</regex>
  <order>srcip</order>
</decoder>

<!-- 2. RFC 5424 syslog from the portal's export. -->
<decoder name="jt-vc-portal-syslog">
  <prematch type="pcre2">^(?:\x3c\d{1,3}\x3e)?1 \S+ \S+ jaas-auth \S+ \S+ \S+ (?:audit [a-z0-9_]+ actor=|jaas-auth logship test event$)</prematch>
</decoder>

<decoder name="jt-vc-portal-syslog-fields">
  <parent>jt-vc-portal-syslog</parent>
  <regex type="pcre2"> jaas-auth \S+ \S+ \S+ (?:audit |jaas-auth logship )([a-z0-9_]+)</regex>
  <order>action</order>
</decoder>

<decoder name="jt-vc-portal-syslog-fields">
  <parent>jt-vc-portal-syslog</parent>
  <regex type="pcre2"> jaas-auth \S+ \S+ \S+ audit [a-z0-9_]+ actor=(\S*) ?(.*)$</regex>
  <order>actor,detail</order>
</decoder>

<!-- 3. CEF from the portal's export. The parent carries the first-seen key
     and so has a regex of its own; its children repeat what it decodes. -->
<decoder name="jt-vc-portal-cef">
  <prematch type="pcre2">^CEF:0\|JT\|jaas-auth\|</prematch>
  <regex type="pcre2">^CEF:0\|JT\|jaas-auth\|[^|]*\|([a-z0-9_]+)\|</regex>
  <order>action</order>
  <fts>name, user, srcip</fts>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">^CEF:0\|JT\|jaas-auth\|[^|]*\|([a-z0-9_]+)\|</regex>
  <order>action</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">^CEF:0\|JT\|jaas-auth\|[^|]*\|[a-z0-9_]+\|audit [a-z0-9_]+ actor=(?:[^ |\\]|\\.)* ?((?:[^|\\]|\\.)*)\|\d+\|</regex>
  <order>detail</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">\|\d+\|src=([0-9A-Fa-f.:]+)(?: |$)</regex>
  <order>ip</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">\|\d+\|src=(?:::ffff:)?([0-9A-Fa-f.:]+)(?: |$)</regex>
  <order>srcip</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">\|\d+\|(?:src=\S+ )?suser=((?:[^=\\]|\\.)*?)(?: [A-Za-z0-9]+=|$)</regex>
  <order>actor</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">\|\d+\|(?:src=\S+ )?suser=((?:[^=\\]|\\.)*?)(?: [A-Za-z0-9]+=|$)</regex>
  <order>user</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">\|\d+\|(?:src=\S+ )?(?:suser=(?:[^=\\]|\\.)*? )?outcome=(ok|fail|warn)(?: |$)</regex>
  <order>result</order>
</decoder>
