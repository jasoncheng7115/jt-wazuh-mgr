<!--
  jt-vc-portal decoders: the portal's security event export
  Copyright Jason Tools Co., Ltd. / AGPL-3.0-or-later

  jt-vc-portal is a meeting portal for 8x8 JaaS and self-hosted Jitsi Meet. In
  its logs it calls itself jaas-auth. It writes one audit record per action to
  audit-log.jsonl in its data directory, and can also send each record to one
  collector as RFC 5424 syslog, CEF or GELF.

  The audit file needs no decoder of ours. Its lines are JSON, and the
  built-in "json" decoder decodes every key: action (a static field), actor,
  role, result, ip, detail. This pack deliberately adds no child decoder to
  "json". Measured on 4.14.7: once "json" has any child, JSON events that the
  child does not take lose all their fields (a Suricata alert decoded to
  nothing and fell to rule 1002). The consequence is that the client address
  of the audit file stays in a field named ip and never becomes srcip.

  The two export shapes have no decoder in Wazuh 4.14.7 at all, so they are
  decoded here into the names the json decoder produces for the file (action,
  actor, ip, detail, result), and one set of rules serves all three:

  1. RFC 5424 syslog (export format "syslog"):
       1 2026-10-11T09:00:00+00:00 vc1 jaas-auth - - - audit login_fail actor=jdoe Attempted account: jdoe
     The manager removes the priority prefix. Wazuh has no RFC 5424 support:
     the line keeps its version digit and nothing is pre-decoded, so the
     prematch sees the whole line. The record carries no address, result or
     role. An actor with a space in it (a guest name) is cut at the space.

  2. CEF (export format "cef"), sent without any syslog header:
       CEF:0|JT|jaas-auth|1.0|login_fail|audit login_fail actor=jdoe ...|6|src=192.0.2.10 suser=jdoe outcome=fail requestClientApplication=...
     The extension escapes "=" inside values as "\=", and the header escapes
     "|" as "\|", so an unescaped "|severity|" and an unescaped "key=" can
     only be structure. Every extension field is read from the severity field
     onward (src, suser, outcome are written in that order), never from the
     header text or the user agent, both of which a client controls. The
     address is decoded twice: as ip, for the shared rules, and as srcip.

  GELF, the third export format, cannot be received by Wazuh.

  Measured: when a sibling's regex does not match (a record without an
  address), the siblings after it are still applied. The first sibling of
  each set always matches.
-->

<!-- 1. RFC 5424 syslog from the portal's export. -->
<decoder name="jt-vc-portal-syslog">
  <prematch type="pcre2">^(?:\x3c\d{1,3}\x3e)?1 \S+ \S+ jaas-auth \S+ \S+ \S+ (?:audit [a-z0-9_]+ actor=|jaas-auth logship test event$)</prematch>
</decoder>

<decoder name="jt-vc-portal-syslog-fields">
  <parent>jt-vc-portal-syslog</parent>
  <regex type="pcre2"> jaas-auth \S+ \S+ \S+ (?:audit |jaas-auth logship )([a-z0-9_]+)</regex>
  <order>action</order>
</decoder>

<decoder name="jt-vc-portal-syslog-fields">
  <parent>jt-vc-portal-syslog</parent>
  <regex type="pcre2"> jaas-auth \S+ \S+ \S+ audit [a-z0-9_]+ actor=(\S*) ?(.*)$</regex>
  <order>actor,detail</order>
</decoder>

<!-- 2. CEF from the portal's export. -->
<decoder name="jt-vc-portal-cef">
  <prematch type="pcre2">^CEF:0\|JT\|jaas-auth\|</prematch>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">^CEF:0\|JT\|jaas-auth\|[^|]*\|([a-z0-9_]+)\|</regex>
  <order>action</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">^CEF:0\|JT\|jaas-auth\|[^|]*\|[a-z0-9_]+\|audit [a-z0-9_]+ actor=(?:[^ |\\]|\\.)* ?((?:[^|\\]|\\.)*)\|\d+\|</regex>
  <order>detail</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">\|\d+\|src=([0-9A-Fa-f.:]+)(?: |$)</regex>
  <order>ip</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">\|\d+\|src=([0-9A-Fa-f.:]+)(?: |$)</regex>
  <order>srcip</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">\|\d+\|(?:src=\S+ )?suser=((?:[^=\\]|\\.)*?)(?: [A-Za-z0-9]+=|$)</regex>
  <order>actor</order>
</decoder>

<decoder name="jt-vc-portal-cef-fields">
  <parent>jt-vc-portal-cef</parent>
  <regex type="pcre2">\|\d+\|(?:src=\S+ )?(?:suser=(?:[^=\\]|\\.)*? )?outcome=(ok|fail|warn)(?: |$)</regex>
  <order>result</order>
</decoder>
