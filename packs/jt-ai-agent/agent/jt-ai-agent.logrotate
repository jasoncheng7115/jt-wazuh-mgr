# jt-ai-agent audit log (installed as /etc/logrotate.d/jt-ai-agent).
# The hook opens the file for every line, so plain rotation is enough;
# create keeps it writable for agent users who are not root.
/var/log/jt-ai-agent/actions.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0622 root root
}

# 1.6: prompts, when the server turns them on (setting "prompts" = local or wazuh).
# Kept 90 days; only root can read them.
/var/log/jt-ai-agent/prompts.log {
    daily
    rotate 90
    compress
    delaycompress
    missingok
    notifempty
    create 0622 root root
}
