# jt-ai-agent audit log (installed as /etc/logrotate.d/jt-ai-agent).
# The hook opens the file for every line, so plain rotation is enough;
# create keeps it writable for agent users who are not root.
/var/log/jt-ai-agent/actions.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0622 root root
}
