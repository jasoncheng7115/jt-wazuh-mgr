<?xml version="1.0" encoding="UTF-8"?>
<!-- jt-ai-agent (macOS, installed as /Library/LaunchDaemons/com.jasontools.jt-ai-agent-config.plist):
     make the settings the Wazuh manager delivers readable for every user's hook, every five minutes. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jasontools.jt-ai-agent-config</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/lib/jt-ai-agent/jt-ai-agent-hook.py</string>
    <string>--sync-config</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
