<!--
  Zimbra decoders, part 1: the proxy access log and the security audit log.
  Shipped by the jt-zimbra pack since 3.0. Before 3.0 the pack's rules named
  these decoders but the pack did not contain them, so the pack only loaded
  on a manager that already had a hand-made copy; on any other manager
  wazuh-analysisd refused the whole ruleset ("Invalid decoder name").

  The file name sorts before the built-in decoders (0005- onwards) on purpose:
  rule and decoder files from every directory are loaded in one name order.

  Every decoder here uses type="pcre2": OS_Regex has no {n,m}, no (?:...) and
  no lookahead.
-->

<!-- ==========================================================
     /opt/zimbra/log/nginx.access.log (Zimbra proxy)
       198.51.100.7:51234 - - [11/Oct/2026:10:00:00 +0800]  "GET https://mail.example.com/ HTTP/1.1" 200 512 "-" "Mozilla/5.0" "127.0.0.1:8443" "192.0.2.10:8443"
     The client address carries its port, which is why the built-in
     web-accesslog decoder never matches this file. The URL is absolute.
     ========================================================== -->

<!-- The proxy logs the absolute URL ("GET https://host/..."). Requiring it keeps
     ordinary access logs out: an IPv6 client of another web server ("2001:db8::5 - -")
     otherwise looks like address:port and loses every other pack's web rules. -->
<decoder name="zimbra-proxy-access">
  <prematch type="pcre2">^[0-9a-fA-F.:]+:\d+ \S+ \S+ \[\d+/\w+/\d+:\d+:\d+:\d+ [+-]\d+\]\s+"\w+ https?://</prematch>
</decoder>

<decoder name="zimbra-proxy-access-fields">
  <parent>zimbra-proxy-access</parent>
  <regex type="pcre2">^(?:::ffff:)?([0-9a-fA-F.:]+):(\d+) \S+ \S+ \[[^\]]+\]\s+"(\w+) (\S+) [^"]*" (\d{3}) (\d+) "([^"]*)" "([^"]*)"</regex>
  <order>srcip, srcport, protocol, url, id, size, referer, user_agent</order>
</decoder>

<!-- Short form without referer and user agent (some proxy templates). -->
<decoder name="zimbra-proxy-access-fields">
  <parent>zimbra-proxy-access</parent>
  <regex type="pcre2">^(?:::ffff:)?([0-9a-fA-F.:]+):(\d+) \S+ \S+ \[[^\]]+\]\s+"(\w+) (\S+) [^"]*" (\d{3}) (\d+)\s*$</regex>
  <order>srcip, srcport, protocol, url, id, size</order>
</decoder>

<!-- ==========================================================
     /opt/zimbra/log/audit.log (logger zimbra.security)
       2026-10-11 11:26:05,929 INFO  [ImapSSLServer-406] [ip=192.0.2.10;oip=198.51.100.7;via=192.0.2.10(nginx/1.24.0);ua=Zimbra/10.1.20_GA_10120;cid=912;] security - cmd=Auth; account=user1@example.com; protocol=imap;
       2026-10-11 11:26:06,984 INFO  [qtp1-9383:https://mail.example.com:8443/service/soap/] [name=user2@example.com;oip=198.51.100.8, 192.0.2.93;port=48030;ua=Apple-iPhone17C3/2307.90 ZPZB/75;soapId=4bbe9d0e;] security - cmd=Auth; account=user2@example.com; protocol=soap;
       ... security - cmd=Auth; account=user3@example.com; protocol=soap; error=authentication failed for [user3@example.com], invalid password;
       ... security - cmd=DelegateAuth; accountId=0000-...; accountName=user4@example.com;

     The same text also reaches syslog when the server has zimbraLogToSyslog
     set, as "<host> zimbra_audit <the line above>". Both shapes decode here;
     the rules count only the copy read from the file (see 100840).

     oip is "client" for a direct connection and "client, proxy[, proxy]"
     when a proxy such as Z-Push or a reverse proxy passed the request on.
     srcip takes the FIRST address, the real client; zimbra.via_proxy keeps
     the last hop. Before 3.0 the decoder required a ";" right after the first
     address, so every proxied line decoded without srcip or user at all.

     Sibling decoders with the same name each add their own fields, so a
     line missing one item (no oip, no account) still gets the others.
     An IPv4-mapped address (::ffff:198.51.100.7) is stored without the
     prefix, so the rules' IPv4 ranges apply to it.
     ========================================================== -->

<!-- ==========================================================
     3.3: every field is read from its own place in the line, not from the
     first place the text happens to appear. A Zimbra log line is
       <date> <level> [<thread>] [<context>] <logger> - <message>
     The thread name carries the request URL and the context carries the
     client's user agent, and the client chooses both. Up to 3.2 the
     decoders took the first "oip=", "ua=", "name=" or "] security - cmd="
     anywhere in the line, so (tested on 4.14.7, sandbox):
       * a request to ".../service/soap/AuthRequest?x=;oip=192.0.2.250;"
         was decoded with srcip 192.0.2.250: the brute-force rules, and
         the opt-in firewall-drop on them, could be pointed at any address;
       * a successful login whose user agent contained
         "] security - cmd=Auth; error=x; account=admin@..." was decoded
         as a FAILED login of that other account, so a password that had
         just been guessed raised no "success after failures" alert.
     Now each regex starts at the line start, skips the thread name (it
     holds no spaces), and walks the context one key=value; pair at a
     time. Zimbra doubles every ";" inside a value (ZimbraLog.encodeArg),
     so a value cannot end a pair or the context early, and the message
     is the text after the context. The client address is the oip= (or,
     without one, ip=) key that precedes ua= in the context; Zimbra adds
     the address keys first (RemoteIP.addToLoggingContext, ImapHandler
     setIDFields), so nothing a client sends can come before them.
     ========================================================== -->

<!-- ==========================================================
     3.2: failed logins have a decoder of their own, zimbra-audit-fail,
     loaded before zimbra-audit so it claims them first. Two reasons:

     * Its fts key (name, user, srcip, location) marks the first failure of
       an (account, address) pair. Rules 100843 (password spraying) and
       100844 (distributed guessing) count those first-seen pairs, which
       makes them count DISTINCT accounts and DISTINCT addresses. In 3.1
       they used different_user / different_srcip, which in 4.14.7 count
       earlier events whose value differs from the current one: seven
       failures of one account and one of another from a shared address
       already counted as "eight accounts" (tested). Because the decoder
       name is part of the key, a failure never marks a pair as seen for
       the login rules (100837/100838), which use zimbra-audit's own key.

     * An unknown account never reaches the cmd= form: Zimbra's account
       SOAP handler (service/account/Auth.java, 10.1.20) writes
         security - Error occurred during authentication: authentication failed for [guess@example.com]. Reason: account not found.
       and only when localconfig zimbra_additional_logging is true
       (default false). Without this branch, password spraying with
       guessed names produced no failure at all.
       3.3: this sentence prints the typed name with String.format, not
       through ZimbraLog.encodeArg, so its line breaks are not removed: a
       client may be able to start a line of its own in audit.log while
       the setting is on (not tested against a live server).

     Every line this decoder takes is a failure: cmd=... with error=
     (wrong password, locked account, preauth mismatch, the lockout itself:
     "error=account lockout due to too many failed logins", which
     LdapLockoutPolicy logs at INFO) or the unknown-account sentence.
     ========================================================== -->
<decoder name="zimbra-audit-fail">
  <prematch type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - (?:cmd=\w[\w ]*;.*? error=|Error occurred during authentication: authentication failed for \[)</prematch>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=(\w[\w ]*);</regex>
  <order>action</order>
  <fts>name, user, srcip, location</fts>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=(\w[\w ]*);</regex>
  <order>action</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? account(?:Name)?=([^;\s]+);</regex>
  <order>user</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - Error occurred during authentication: authentication failed for \[([^\]]+)\]</regex>
  <order>user</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:(?!ua=)\w+=(?:[^;\[\]]|;;)*;)*?oip=(?:::ffff:)?([0-9a-fA-F.:]+)[,;]</regex>
  <order>srcip</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:(?:name|aname|mid)=[^;\[\]]*;)*ip=(?:::ffff:)?([0-9a-fA-F.:]+);(?!(?:(?!ua=)\w+=(?:[^;\[\]]|;;)*;)*?oip=)</regex>
  <order>srcip</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:(?!ua=)\w+=(?:[^;\[\]]|;;)*;)*?oip=[^;\[\]]*, ?(?:::ffff:)?([0-9a-fA-F.:]+);</regex>
  <order>zimbra.via_proxy</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*?ua=((?:[^;]|;;)*);</regex>
  <order>zimbra.ua</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[[^\]:\s]*:(\w+://\S+)\] \[</regex>
  <order>url</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? protocol=(\w+);</regex>
  <order>protocol</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? error=([^;]+);</regex>
  <order>zimbra.error</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - Error occurred during authentication: authentication failed for \[[^\]]*\]\. Reason: ([^.]+)</regex>
  <order>zimbra.error</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:(?!ua=)\w+=(?:[^;\[\]]|;;)*;)*?oproto=(\w+);</regex>
  <order>zimbra.oproto</order>
</decoder>

<!-- The account again, as a dynamic field for same_field (100844). -->
<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? account(?:Name)?=([^;\s]+);</regex>
  <order>zimbra.account</order>
</decoder>

<decoder name="zimbra-audit-fail-fields">
  <parent>zimbra-audit-fail</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - Error occurred during authentication: authentication failed for \[([^\]]+)\]</regex>
  <order>zimbra.account</order>
</decoder>

<!-- ==========================================================
     Everything else in audit.log: logins, preauth, DelegateAuth, and
     (3.2) the administrative commands Zimbra's admin SOAP handlers log
     with the attributes they changed (service/admin/*.java, 10.1.20):
       security - cmd=ModifyAccount; name=user1@example.com; zimbraIsAdminAccount=TRUE;
       security - cmd=CreateAccount; name=new@example.com; zimbraCOSId=...;
       security - cmd=ModifyConfig; zimbraMtaMyNetworks=127.0.0.0/8 0.0.0.0/0;
     For those, user is the account changed (name= after cmd=) and
     srcuser the administrator (name= in the context brackets).
     A command name may contain spaces ("ChangePrimaryEmail account
     renamed", "auto provision Account"), hence cmd=\w[\w ]*.
     ========================================================== -->

<!-- fts (first time seen) is on the parent: on same-name sibling decoders
     4.14.7 accepts it only on the first sibling and then never applies it
     (tested). The key is (account, client address, administrator for a
     DelegateAuth, agent): rules 100837, 100838 and 100896 use it. -->
<decoder name="zimbra-audit">
  <prematch type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;</prematch>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=(\w[\w ]*);</regex>
  <order>action</order>
  <fts>name, srcuser, user, srcip, location</fts>
</decoder>

<!-- The parent's own regex is not applied once a child matches, so the
     action is decoded again here. -->
<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=(\w[\w ]*);</regex>
  <order>action</order>
</decoder>

<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? account(?:Name)?=([^;\s]+);</regex>
  <order>user</order>
</decoder>

<!-- 3.2: the account an administrative command changed. -->
<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*; name=([^;]+);</regex>
  <order>user</order>
</decoder>

<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:(?!ua=)\w+=(?:[^;\[\]]|;;)*;)*?oip=(?:::ffff:)?([0-9a-fA-F.:]+)[,;]</regex>
  <order>srcip</order>
</decoder>

<!-- A direct connection (the admin port, no proxy) has ip= and no oip=. -->
<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:(?:name|aname|mid)=[^;\[\]]*;)*ip=(?:::ffff:)?([0-9a-fA-F.:]+);(?!(?:(?!ua=)\w+=(?:[^;\[\]]|;;)*;)*?oip=)</regex>
  <order>srcip</order>
</decoder>

<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:(?!ua=)\w+=(?:[^;\[\]]|;;)*;)*?oip=[^;\[\]]*, ?(?:::ffff:)?([0-9a-fA-F.:]+);</regex>
  <order>zimbra.via_proxy</order>
</decoder>

<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*?ua=((?:[^;]|;;)*);</regex>
  <order>zimbra.ua</order>
</decoder>

<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[[^\]:\s]*:(\w+://\S+)\] \[</regex>
  <order>url</order>
</decoder>

<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? protocol=(\w+);</regex>
  <order>protocol</order>
</decoder>

<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? error=([^;]+);</regex>
  <order>zimbra.error</order>
</decoder>

<!-- 3.2: "mode=recoveryCode" (a login with a password-reset recovery code)
     and "info=account re-activated from lockout status upon successful
     login" (LdapProvisioning.java, LdapLockoutPolicy.java, 10.1.20). -->
<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? mode=([^;]+);</regex>
  <order>zimbra.mode</order>
</decoder>

<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? info=([^;]+);</regex>
  <order>zimbra.info</order>
</decoder>

<!-- Logins that saslauthd forwards for SMTP AUTH carry oproto=smtp (and an
     smtp:// thread URL on the internal admin port 7073). -->
<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:(?!ua=)\w+=(?:[^;\[\]]|;;)*;)*?oproto=(\w+);</regex>
  <order>zimbra.oproto</order>
</decoder>

<!-- DelegateAuth: the context name= is the administrator, accountName= the
     account taken over. Only for this command, so a login's fts key stays
     (account, address). -->
<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[name=([^;\[\]]+);(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=DelegateAuth;</regex>
  <order>srcuser</order>
</decoder>

<!-- 3.2: the administrator behind an administrative command (the context
     name=). Not for logins, preauth or DelegateAuth, so their fts keys
     stay what they were. -->
<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[name=([^;\[\]]+);(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=(?!(?:Auth|AdminAuth|SSOAuth|PreAuth|DelegateAuth);)\w[\w ]*;</regex>
  <order>srcuser</order>
</decoder>

<!-- The account again, as a dynamic field: same_user does not match against
     events kept for if_matched_group in 4.14.7, same_field does (tested). -->
<decoder name="zimbra-audit-fields">
  <parent>zimbra-audit</parent>
  <regex type="pcre2">^[^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*\] security - cmd=\w[\w ]*;.*? account(?:Name)?=([^;\s]+);</regex>
  <order>zimbra.account</order>
</decoder>
