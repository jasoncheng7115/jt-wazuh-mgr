<!--
  Zimbra 威脅偵測規則（資料外洩／持久化／反鑑識／CVE 利用）
  檔案：etc/rules/06-zimbra_threat_rules.xml
  區段：100920-100999
  版本：v3.0（jt-zimbra 3.0）

  相依：
    - 解碼器 zimbra-proxy-access（decoders/0001-zimbra_decoders.xml，3.0 起隨套件提供）
    - CDB 清單 etc/lists/zimbra-internal-networks（3.1 起為選用：私有網段已寫進規則）
  3.0 起不再引用其他套件的清單（舊 100991 已移除，見該處說明）。
  3.2: PAM and sudoers FIM (100936, 100938, 100939), ClientUploader (100994),
       CVE-2020-7796 (100995), exploit URLs answered 404 (100997); 100963 at
       level 5; 100976 and 100977 descriptions corrected; 100979 can fire.
  3.3: 100920 also sees the web client's export (/home/... without
       /service) and no longer a Briefcase multi-file download. The IDs
       100990 and 100991, free since 3.0, are used again by different rules
       in 08-zimbra_soap_rules.xml (the rule-ID range is full).
  3.4: 100936-100942 removed (generic Linux host rules, now in the
       jt-linux-integrity pack); 100943 (Zimbra startup scripts and
       localconfig.xml) stays.
-->

<!-- ==========================================================
     資料外洩 100920-100939
     背景：Zimbra「不記錄郵件的直接下載」，只能從 Proxy 層流量
           特徵與間接徵兆偵測。
     ========================================================== -->
<group name="zimbra,exfiltration,">

  <!-- REST 信箱整包匯出：大量竊信的主要管道
       3.3: the web client's own export (Preferences, Import/Export) asks
       for /home/<account>/<folder>?fmt=tgz, without /service: nginx maps
       /home/ to the REST servlet (zm-web-client ZmImportExportController.js,
       a GET form). Until 3.2 only /service/home/ was matched, so the export
       people actually click was never seen. tar is the third archive
       format (FormatterFactory.java, 10.1.20). A Briefcase multi-file
       download (fmt=zip with list=) and a single item (id=) are not a
       mailbox export. -->
  <rule id="100920" level="10">
    <if_sid>100820</if_sid>
    <url type="pcre2">(?i)^(?:https?://[^/\s]+)?(?:/service)?/(?:home|user)/[^?\s]*\?(?!(?:[^\s#]*\x26)?(?:list|id)=)(?:[^\s#]*\x26)?fmt=(?:tgz|zip|tar)(?:\x26|$)</url>
    <description>[WARN] Full mailbox export: $(url) from: $(srcip)</description>
    <mitre>
      <id>T1114.001</id>
    </mitre>
  </rule>

  <rule id="100921" level="0">
    <if_sid>100920</if_sid>
    <srcip>10.0.0.0/8</srcip>
    <srcip>172.16.0.0/12</srcip>
    <srcip>192.168.0.0/16</srcip>
    <srcip>127.0.0.0/8</srcip>
    <srcip>100.64.0.0/10</srcip>
    <srcip>fc00::/7</srcip>
    <srcip>fe80::/10</srcip>
    <description>Mailbox export from an internal network, normal backup or user action</description>
  </rule>

  <!-- 3.0: 100922 had no condition and was a sibling of 100921, so an
       internal export could come out at level 14. -->
  <rule id="100922" level="14">
    <if_sid>100920</if_sid>
    <srcip negate="yes">10.0.0.0/8</srcip>
    <srcip negate="yes">172.16.0.0/12</srcip>
    <srcip negate="yes">192.168.0.0/16</srcip>
    <srcip negate="yes">127.0.0.0/8</srcip>
    <srcip negate="yes">100.64.0.0/10</srcip>
    <srcip negate="yes">fc00::/7</srcip>
    <srcip negate="yes">fe80::/10</srcip>
    <list field="srcip" lookup="not_address_match_key">etc/lists/zimbra-internal-networks</list>
    <description>[HIGH] Full mailbox export from an external source, possible data exfiltration: $(url) from: $(srcip)</description>
    <mitre>
      <id>T1114.001</id>
    </mitre>
    <group>zimbra_mailbox_export,</group>
  </rule>

  <!-- 3.0: counted through the group; every export ends at a child of
       100920, so with if_matched_sid 100920 nothing was ever counted. Now
       a child of 100922: repeated EXTERNAL exports. -->
  <rule id="100923" level="15" frequency="3" timeframe="600">
    <if_sid>100922</if_sid>
    <if_matched_group>zimbra_mailbox_export</if_matched_group>
    <same_source_ip />
    <description>[CRITICAL] Repeated mailbox exports in a short window, assessed as bulk data theft: $(srcip)</description>
    <mitre>
      <id>T1114.001</id>
    </mitre>
  </rule>

  <!-- SOAP／搜尋 API 大量呼叫：XSS 挾持 session 逐日撈信的特徵
       基礎規則須 level >= 1 才能被 if_matched_sid 計數（level 0 會先被丟棄），
       以 no_log 抑制輸出 -->
  <!-- 【已停用 2026-08-10】改由 08-zimbra_soap_rules.xml 的 100971/100972/100973 取代。
       舊做法以 nginx URL 計數，srcip 是 Z-Push 閘道且無法區分 WaitSet 長輪詢，必然誤報。
  <rule id="100927" level="1">
    <if_sid>100820</if_sid>
    <url type="pcre2">/service/soap|/h/search</url>
    <options>no_log</options>
    <description>Zimbra SOAP or search API call, counted for correlation</description>
  </rule>
  -->

  <!-- 【已停用 2026-08-10】改由 08-zimbra_soap_rules.xml 的 100971/100972/100973 取代。
       舊做法以 nginx URL 計數，srcip 是 Z-Push 閘道且無法區分 WaitSet 長輪詢，必然誤報。
  <rule id="100924" level="12" frequency="30" timeframe="300">
    <if_matched_sid>100927</if_matched_sid>
    <same_source_ip />
    <description>[HIGH] High volume of search or SOAP API calls, suggesting automated mail harvesting: $(srcip)</description>
    <mitre>
      <id>T1114</id>
    </mitre>
  </rule>
  -->

  <!-- 100928 / 100925 (one account sending a burst of mail) moved to
       08-zimbra_soap_rules.xml in 3.0: they read audit.log, which never
       logs a send, and so could not fire. -->

  <!-- 出向流量遭阻擋（搭配指南 1-3 egress filtering）
       ※ 不掛 <if_sid>4100</if_sid>：實測該父規則參照會被 analysisd 忽略，
         導致整條規則失效。ZIMBRA-EGRESS-DENY 這個 log prefix 已足夠獨特，
         直接以 match 比對即可。 -->
  <rule id="100926" level="13">
    <match>ZIMBRA-EGRESS-DENY</match>
    <description>[HIGH] The zimbra account attempted an unauthorised outbound connection, suggesting C2 or exfiltration</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>command_control,</group>
  </rule>

</group>

<!-- ==========================================================
     持久化 100940-100959
     ========================================================== -->
<group name="zimbra,persistence,">

  <!-- 3.4: the host-integrity rules that used to live here (100936 NOPASSWD
       ALL, 100937 package-manager writes, 100938 PAM, 100939 sudo, 100940
       cron, 100941 systemd units, 100942 authorized_keys) matched every
       Linux agent, not only Zimbra servers, and covered only part of each
       area. They moved to the jt-linux-integrity pack (132900-132999), which
       covers every cron and at location, user and generator units, PAM
       modules, the account databases and ld.so.preload, and separates the
       writer (package manager, the file's own tool, anything else). Install
       it to keep this coverage; the zimbra group still monitors the files.
       The IDs stay unused. -->

  <rule id="100943" level="14">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/opt/zimbra/bin/zm.*ctl$|^/opt/zimbra/conf/localconfig\.xml$</field>
    <description>[HIGH] Zimbra startup script or core configuration tampered with: $(file)</description>
    <mitre>
      <id>T1543</id>
    </mitre>
  </rule>

</group>

<!-- ==========================================================
     反鑑識 100960-100974
     依 SOP 決策點，發現反鑑識行為即為「建議重建」的獨立條件。
     ========================================================== -->
<group name="zimbra,defense_evasion,">

  <!-- 3.2: this rule never fired: its level 0 sibling 100800 took every
       web-root event first. Once 100800 became level 1 (3.2), it would have
       raised level 13 for every modification, because a content change
       always changes mtime as well. It now takes only what backdating looks
       like to FIM: a non-stock executable artefact (jsp, jspx, class, jar,
       war) in the web root whose ONLY change is the modification time, the
       touch -r / touch -d an attacker uses to make a planted file look as old
       as its neighbours. A stock file with only its mtime changed stays at
       100801 (level 0). lib/ext is left to 100806 (level 15 for any
       non-stock file there). -->
  <rule id="100960" level="13">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/opt/zimbra/(?:jetty_base|jetty)/webapps/.*\.(?:jsp|jspx|class|war|jar)$</field>
    <field name="changed_fields" type="pcre2">^mtime$</field>
    <list field="file" lookup="not_match_key">etc/lists/zimbra-webfiles</list>
    <options>no_full_log</options>
    <description>[HIGH] Only the modification time changed on a non-stock executable file in the Zimbra web directory, suggesting timestomping: $(file)</description>
    <mitre>
      <id>T1070.006</id>
    </mitre>
  </rule>

  <rule id="100961" level="14">
    <if_sid>553</if_sid>
    <field name="file" type="pcre2">^/opt/zimbra/log/|^/var/log/(auth|secure|wtmp|btmp)</field>
    <description>[HIGH] Log file deleted, suggesting evidence destruction: $(file)</description>
    <mitre>
      <id>T1070.002</id>
    </mitre>
  </rule>

  <!-- 3.2: level 14 to 5 and no Zimbra wording: the built-in parents are
       503 (agent started) and 504 (agent disconnected) for EVERY agent, not
       only Zimbra servers; at 14 a laptop going to sleep was mailed (3 to
       36 a day measured on one manager). The ID and parents stay, because
       a site rule may count it (if_matched_sid 100963). -->
  <rule id="100963" level="5">
    <if_sid>503,504</if_sid>
    <description>Wazuh agent started or disconnected, its monitoring was interrupted</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

</group>

<!-- ==========================================================
     已知 CVE 利用特徵 100975-100989
     完整 CVE 對照見部署指南附錄 D。
     ========================================================== -->
<group name="zimbra,exploit_attempt,">

  <!-- CVE-2022-27925 / CVE-2022-37042：mboximport 任意檔案上傳
       Any status counts: Volexity (2022-08-10) saw the exploit request
       return 401 and still write the shell. A 404 (the backup extension is
       not installed, as on every FOSS server) ends at 100997 instead. -->
  <rule id="100975" level="14">
    <if_sid>100820</if_sid>
    <url type="pcre2">/service/extension/backup/mboximport</url>
    <description>[HIGH] mboximport endpoint accessed, matches the CVE-2022-27925 and CVE-2022-37042 exploitation pattern (a 401 does not mean it failed): $(url) status: $(id) from: $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- 路徑穿越／LFI
       3.2: case-insensitive, and the forms Jetty and nginx decode
       differently: "..;/" (path parameter), "..%2f", "%2e./", ".%2e",
       a backslash, double encoding (%252e) and overlong UTF-8 (%c0%ae).
       The description no longer names CVE-2025-68645, which is the
       /h/rest file inclusion of 100977, not a traversal in the path. -->
  <rule id="100976" level="13">
    <if_sid>100820</if_sid>
    <url type="pcre2">(?i)\.\.(?:/|;|%2f|%5c|\x5c)|%2e(?:%2e|\.)|\.%2e|%252e%252e|%c0%ae</url>
    <description>[HIGH] Path traversal attempt in a request to Zimbra: $(url) from: $(srcip)</description>
    <mitre>
      <id>T1190</id>
      <id>T1083</id>
    </mitre>
  </rule>

  <!-- /h/rest 端點濫用：CVE-2025-68645 (unauthenticated file inclusion
       through RestFilter, CISA KEV 2026-01-22, fixed in 10.1.13),
       CVE-2024-54663 and CVE-2025-27914 (fixed in 10.1.3). -->
  <rule id="100977" level="12">
    <if_sid>100820</if_sid>
    <url type="pcre2">/h/rest\?</url>
    <description>[HIGH] /h/rest endpoint accessed, the CVE-2025-68645 (KEV), CVE-2024-54663 and CVE-2025-27914 entry point: $(url) from: $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- CVE-2019-9621: proxyservlet SSRF.
       3.0: the proxy servlet is also how the web client fetches previews
       for zimlets (an external URL, refused or not by
       zimbraProxyAllowedDomains); two such requests were reported here at
       level 13. The exploit points the servlet back at the server itself
       or the internal network, so only those targets are matched now:
       loopback, the admin and internal ports, private and link-local
       addresses (cloud metadata), in plain and URL-encoded form. -->
  <rule id="100978" level="13">
    <if_sid>100820</if_sid>
    <url type="pcre2">(?i)/service/proxy\?(?:.*\x26)?target=(?:https?(?::|%3A)(?://|%2F%2F))?(?:[^/\x26%]*(?:@|%40))?(?:localhost|127\.|0\.0\.0\.0|\[?::1|\[?%3A%3A1|10\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.|169\.254\.|[^/\x26%?]*(?::|%3A)(?:7071|7073|7025|7110|7143|7993|7995|8080|8443|11211)\b)</url>
    <description>[HIGH] proxyservlet SSRF attempt aimed at an internal target (the server itself or the internal network), CVE-2019-9621: $(url) from: $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- 3.2: ClientUploader, the upload step of the 2019 chain (XXE
       CVE-2019-9670 in Autodiscover, then the proxy servlet SSRF
       CVE-2019-9621 for an admin token, then a JSP uploaded here). The
       extension was removed in 10.0.1, so on a current server every request
       is an attempt (a 404 ends at 100997). -->
  <rule id="100994" level="12">
    <if_sid>100820</if_sid>
    <url type="pcre2">(?i)/service/extension/clientUploader/upload</url>
    <description>[HIGH] Request to Zimbra's ClientUploader upload endpoint, the file-planting step after CVE-2019-9670 and CVE-2019-9621: $(url) status: $(id) from: $(srcip)</description>
    <mitre>
      <id>T1190</id>
      <id>T1505.003</id>
    </mitre>
  </rule>

  <!-- 3.2: CVE-2020-7796 (CISA KEV 2026-02-17), server-side request
       forgery through the WebEx zimlet's httpPost.jsp. A 404 (zimlet not
       deployed) ends at 100997. -->
  <rule id="100995" level="12">
    <if_sid>100820</if_sid>
    <url type="pcre2">(?i)/service/zimlet/com_zimbra_webex/httpPost\.jsp</url>
    <description>[HIGH] Request to the WebEx zimlet's httpPost.jsp, the CVE-2020-7796 SSRF entry point (KEV): $(url) status: $(id) from: $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- 3.2: the endpoint of an exploit attempt does not exist on this
       server (HTTP 404): an attempt, not a compromise. -->
  <rule id="100997" level="8">
    <if_sid>100975,100994,100995</if_sid>
    <id>^404$</id>
    <description>Exploit attempt against an endpoint this Zimbra server does not have (HTTP 404): $(url) from: $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>exploit_attempt,</group>
  </rule>

  <!-- ★ CVE-2022-41352 類：郵件觸發寫檔 —— 完全無 HTTP 痕跡的入侵管道
         此規則可直接回答「入侵管道為何」，前提是 whodata 必須真的啟用
       3.2: a child of 100803, not of 100802. As a sibling of 100803 (both
       level 15, 100803 loaded first from 01-) it never fired: every web
       shell written by a named process ended at 100803 (verified with a
       synthetic whodata event, writer /usr/bin/perl). -->
  <rule id="100979" level="15">
    <if_sid>100803</if_sid>
    <field name="process_name" type="pcre2">(?i)(amavis|cpio|unrar|tar|pax|perl|clam)</field>
    <description>[CRITICAL] File in the web directory written by a mail-handling process, assessed as a mail-triggered file drop of the CVE-2022-41352 class: $(file) process: $(process_name)</description>
    <mitre>
      <id>T1566.001</id>
    </mitre>
    <group>webshell,</group>
  </rule>

  <!-- 通用：對 Zimbra 端點的密集掃描 -->
  <rule id="100983" level="1">
    <if_sid>100820</if_sid>
    <id>^404$</id>
    <options>no_log</options>
    <description>Zimbra 404 response, counted for correlation</description>
  </rule>

  <rule id="100981" level="10" frequency="20" timeframe="120">
    <if_matched_sid>100983</if_matched_sid>
    <same_source_ip />
    <description>[WARN] Large number of 404 responses, suggesting path scanning: $(srcip)</description>
    <mitre>
      <id>T1595.003</id>
    </mitre>
  </rule>

  <!-- 3.1: private ranges are written into the rule; the optional list only
       adds addresses (100985).
       3.0: a 404 burst from an internal address is usually a proxy (Z-Push,
       a reverse proxy) carrying many clients, or a user's own script:
       the four 100981 alerts in 41 days here were all one internal script.
       Recorded at level 3 instead of 10. -->
  <rule id="100984" level="3">
    <if_sid>100981</if_sid>
    <srcip>10.0.0.0/8</srcip>
    <srcip>172.16.0.0/12</srcip>
    <srcip>192.168.0.0/16</srcip>
    <srcip>127.0.0.0/8</srcip>
    <srcip>100.64.0.0/10</srcip>
    <srcip>fc00::/7</srcip>
    <srcip>fe80::/10</srcip>
    <description>Many 404 responses for one internal address, often a proxy carrying many clients or a script: $(srcip)</description>
  </rule>

  <rule id="100985" level="3">
    <if_sid>100981</if_sid>
    <list field="srcip" lookup="address_match_key">etc/lists/zimbra-internal-networks</list>
    <description>Many 404 responses for one address listed as internal: $(srcip)</description>
  </rule>

  <!-- 掃描後成功：探測轉為得手 -->
  <rule id="100982" level="14" timeframe="600">
    <if_sid>100823</if_sid>
    <if_matched_sid>100981</if_matched_sid>
    <same_source_ip />
    <description>[HIGH] Heavy scanning followed by successful access to a non-stock JSP, the scan appears to have succeeded: $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

</group>

<!-- ==========================================================
     IOC 獵捕 100990-100999
     ※ FIM 告警不含檔案內容，無法以 <match> 比對字串。
       改採「雜湊 CDB」與「外部內容掃描輸出」雙軌。
     ========================================================== -->
<group name="zimbra,ioc,">

  <!--
    The old 100990 was removed 2026-09-01 (3.3 reuses the ID for another
    rule, see 08-zimbra_soap_rules.xml). It matched a CDB list that shipped containing one
    placeholder hash, so a level 15 rule had never fired and never could. Two
    further problems came to light on inspection: it read a field named sha256,
    while a syscheck event carries syscheck.sha256_after, and jt-malware-hash
    rule 100141 already does exactly this job against a list of about 1.1 million
    hashes that is rebuilt nightly.

    Install jt-malware-hash for hash matching on file integrity events. A rule
    that looks like coverage and provides none is worse than no rule at all.
  -->

  <!--
    The old 100991 was removed in 3.0 (3.3 reuses the ID, see
    08-zimbra_soap_rules.xml). It looked up srcip in the jt-ioc pack's list
    (etc/lists/jason_tools_threat_ip). Without jt-ioc, analysisd warned that
    the list could not be loaded and ignored the rule; with jt-ioc, the IOC
    pack's own rule 906001 already alerts on any event whose srcip is on that
    list, Zimbra's included, at level 12. Install jt-ioc for known-bad
    address matching.
  -->

  <!-- 內容特徵掃描結果（由 zimbra-content-scan.sh 產生） -->
  <rule id="100992" level="15">
    <if_sid>100880</if_sid>
    <field name="zimbra_audit.event">^webshell_signature$</field>
    <description>[CRITICAL] File contents match a web shell signature: $(zimbra_audit.object) signature: $(zimbra_audit.value)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>webshell,</group>
  </rule>

</group>
