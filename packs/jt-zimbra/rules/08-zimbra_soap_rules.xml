<!--
  Zimbra SOAP rules (mailbox.log)          100970-100974, 100925, 100928-100935, 100851
  Decoder: zimbra-mailbox-soap (decoders/0002-zimbra_mailbox_decoders.xml)

  Why mailbox.log and not the nginx access log: the access log shows only
  "/service/soap" (the operation travels in the POST body), and behind
  Z-Push or a reverse proxy its client address is the proxy's. mailbox.log
  has the account, the client the proxy reported, and the operation.

  3.0 (2026-10-11):
  * 100972/100973 fired 109 times in 41 days on two servers (level 12 and
    14, all mailed) and every one was a phone syncing through Z-Push: Z-Push
    lists each folder with SearchRequest on every sync. A third of them were
    also counted twice, once from mailbox.log and once from the syslog copy
    (zimbraLogToSyslog). Now: Z-Push's SearchRequest is not counted (its
    GetMsgRequest, which is mail actually downloaded, still is), and only
    the file copy counts. Replayed on 8.8 days of real lines: 2.7 a day
    before, 0.8 a day after at the 30 threshold, all of the remainder one
    administrator session bulk-reading one mailbox (see 100935).
  * 100974 named one site's monitoring account. It reads the list
    etc/lists/zimbra-service-accounts instead.
  * 100928/100925 (an account sending a burst of mail) and 100851 (two-factor
    changes) looked for SendMsg and TwoFactorAuth in audit.log, which logs
    neither, so they could not fire. They now read the SOAP operations here.
  * Counting uses the pack group zimbra_soap_read (if_matched_group).
-->

<group name="zimbra,exfiltration,soap,">

  <rule id="100970" level="0">
    <decoded_as>zimbra-mailbox-soap</decoded_as>
    <location>/opt/zimbra/log/mailbox.log</location>
    <description>Zimbra mailbox SOAP call (base rule)</description>
  </rule>

  <!-- The syslog copy (program "zimbra_mailbox"): decoded, not counted. -->
  <rule id="100834" level="0">
    <decoded_as>zimbra-mailbox-soap</decoded_as>
    <location type="pcre2">^(?!.*/opt/zimbra/log/mailbox\.log$)</location>
    <description>Zimbra mailbox line received through syslog, a copy of mailbox.log (not counted)</description>
  </rule>

  <!-- Counted: operations that fetch message or contact content. -->
  <rule id="100971" level="1">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:GetMsgRequest|GetConvRequest|ExportContactsRequest|GetContactsRequest|SearchGalRequest)$</action>
    <options>no_log</options>
    <description>Zimbra content-read SOAP operation, counted for correlation: $(action) by $(dstuser)</description>
    <group>zimbra_soap_read,</group>
  </rule>

  <!-- Counted: searches, except Z-Push's folder listing on every sync. -->
  <rule id="100929" level="1">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:SearchRequest|SearchConvRequest)$</action>
    <match type="pcre2">^(?!.*[\[;]ua=[^;\]]*ZPZB/)</match>
    <options>no_log</options>
    <description>Zimbra search SOAP operation, counted for correlation: $(action) by $(dstuser)</description>
    <group>zimbra_soap_read,</group>
  </rule>

  <!-- Same account, many reads in five minutes. Counted per account, not
       per address: everyone behind Z-Push or a proxy shares an address. -->
  <rule id="100972" level="12" frequency="30" timeframe="300">
    <if_matched_group>zimbra_soap_read</if_matched_group>
    <same_user />
    <description>[HIGH] Zimbra account read a large volume of message content in a short window, suggesting automated harvesting: $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1114</id>
    </mitre>
    <group>exfiltration,</group>
  </rule>

  <!-- Three times the 100972 threshold: 100972 fires every 30 reads, so a
       third 100972 for the account within five minutes is 90 reads. (As a
       sibling with frequency 90, 100972 always took the event first.) -->
  <rule id="100973" level="14" frequency="3" timeframe="300">
    <if_matched_sid>100972</if_matched_sid>
    <same_user />
    <description>[HIGH] Zimbra account read an extreme volume of message content, strongly suggesting data theft: $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1114</id>
    </mitre>
    <group>exfiltration,</group>
  </rule>

  <!-- Accounts listed in etc/lists/zimbra-service-accounts (monitoring
       probes, archivers) are expected to read a lot. -->
  <rule id="100974" level="0">
    <if_sid>100972,100973</if_sid>
    <list field="user" lookup="match_key">etc/lists/zimbra-service-accounts</list>
    <description>Bulk reading by a listed Zimbra service account (excluded)</description>
  </rule>

  <!-- The same when an administrator reads someone's mailbox through a
       delegated session: the line names the mailbox as name= and the
       administrator as aname=. Listing that administrator account excludes
       its tool, not the mailbox owner. -->
  <rule id="100935" level="0">
    <if_sid>100972,100973</if_sid>
    <list field="zimbra.aname" lookup="match_key">etc/lists/zimbra-service-accounts</list>
    <description>Bulk reading through a delegated session of a listed service account (excluded)</description>
  </rule>

  <!-- Sending: webmail and Z-Push both send with SendMsgRequest. -->
  <rule id="100928" level="1">
    <if_sid>100970</if_sid>
    <action>SendMsgRequest</action>
    <options>no_log</options>
    <description>Zimbra mail send event, counted for correlation</description>
  </rule>

  <rule id="100925" level="12" frequency="50" timeframe="300">
    <if_matched_sid>100928</if_matched_sid>
    <same_user />
    <description>[HIGH] One account sent a large volume of mail in a short window, the account may be hijacked: $(dstuser)</description>
    <mitre>
      <id>T1114.002</id>
    </mitre>
  </rule>

  <!-- Two-factor and application passwords. An application password is a
       way around two-factor login; generating one is how a session thief
       keeps access after the session ends. -->
  <rule id="100851" level="12">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:EnableTwoFactorAuth|DisableTwoFactorAuth|GenerateScratchCodes|CreateAppSpecificPassword|RevokeAppSpecificPassword|RevokeTrustedDevice)Request$</action>
    <description>[HIGH] Two-factor settings changed, backup codes or an application password generated: $(action) by $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1556.006</id>
    </mitre>
  </rule>

  <!-- Mail filter rules saved. Forwarding or deleting rules are the usual
       trace of a business-mail compromise (the polling rules 100883/100884
       see the result later; this sees the change when it happens). -->
  <rule id="100930" level="5">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:ModifyFilterRules|ModifyOutgoingFilterRules)Request$</action>
    <description>Zimbra mail filter rules changed: $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1564.008</id>
    </mitre>
  </rule>

  <rule id="100932" level="3">
    <if_sid>100970</if_sid>
    <action>ChangePasswordRequest</action>
    <description>Zimbra account password changed by its user: $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- Changes made in the admin console (or with any admin token), not by
       Zimbra's own command-line tools. -->
  <rule id="100931" level="8">
    <if_sid>100970</if_sid>
    <url type="pcre2">^https?://\S*/service/admin/soap</url>
    <action type="pcre2">^(?:CreateAccount|DeleteAccount|RenameAccount|SetPassword|ModifyAccount|AddAccountAlias|GrantRight|RevokeRight|ModifyConfig|ModifyCos|ModifyDomain|CreateDomain|DeployZimlet|UndeployZimlet|ModifyZimlet|ModifyServer|CreateDistributionList|AddDistributionListMember|ModifyDistributionList)Request$</action>
    <match type="pcre2">^(?!.*[\[;]ua=(?:zm[a-z]+|ZCS)/)</match>
    <description>Zimbra administrative change: $(action) by $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_changed,</group>
  </rule>

</group>
