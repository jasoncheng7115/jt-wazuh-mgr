<!--
  Zimbra SOAP rules (mailbox.log)          100970-100974, 100895-100899, 100925, 100928-100934, 100851
  Decoder: zimbra-mailbox-soap (decoders/0002-zimbra_mailbox_decoders.xml)

  Why mailbox.log and not the nginx access log: the access log shows only
  "/service/soap" (the operation travels in the POST body), and behind
  Z-Push or a reverse proxy its client address is the proxy's. mailbox.log
  has the account, the client the proxy reported, and the operation.

  3.0 (2026-10-11):
  * 100972/100973 fired 109 times in 41 days on two servers (level 12 and
    14, all mailed) and every one was a phone syncing through Z-Push: Z-Push
    lists each folder with SearchRequest on every sync. A third of them were
    also counted twice, once from mailbox.log and once from the syslog copy
    (zimbraLogToSyslog). Now: Z-Push's SearchRequest is not counted (its
    GetMsgRequest, which is mail actually downloaded, still is), and only
    the file copy counts. Replayed on 8.8 days of real lines: 2.7 a day
    before, 0.8 a day after at the 30 threshold, all of the remainder one
    administrator session bulk-reading one mailbox (3.1: see 100895).
  * 100974 named one site's monitoring account. It reads the optional list
    etc/lists/zimbra-service-accounts instead (3.1: not needed by default,
    see 100895).
  * 100928/100925 (an account sending a burst of mail) and 100851 (two-factor
    changes) looked for SendMsg and TwoFactorAuth in audit.log, which logs
    neither, so they could not fire. They now read the SOAP operations here.
  * Counting uses the pack group zimbra_soap_read (if_matched_group).

  3.3 (2026-10-15):
  * Zimbra's own tools are left out only when the session belongs to the
    built-in "zimbra" account (name=zimbra, or aname=zimbra for a
    delegated session) from no address or a private one. Until 3.2 the
    user agent alone decided, so a client sending "User-Agent: ZCS" could
    read a mailbox, change filters or identities without being counted.
    The delegated-session test (aname=) and Z-Push's marker (ZPZB/ in the
    user agent) are read from the context itself, not from anywhere in
    the line (a URL could carry ";aname=").
  * 100935: recovery address or delegated rights changed. 100816 also
    follows a password change, a two-factor change and 100935.
  * 100990/100991 (in 03-zimbra_auth_rules.xml, because 100842 counts
    them): SOAP logins refused (the copy of audit.log, level 0) and a
    wrong two-factor code after a correct password (level 5).
-->

<group name="zimbra,exfiltration,soap,">

  <rule id="100970" level="0">
    <decoded_as>zimbra-mailbox-soap</decoded_as>
    <location>/opt/zimbra/log/mailbox.log</location>
    <description>Zimbra mailbox SOAP call (base rule)</description>
  </rule>

  <!-- The syslog copy (program "zimbra_mailbox"): decoded, not counted. -->
  <rule id="100834" level="0">
    <decoded_as>zimbra-mailbox-soap</decoded_as>
    <location type="pcre2">^(?!.*/opt/zimbra/log/mailbox\.log$)</location>
    <description>Zimbra mailbox line received through syslog, a copy of mailbox.log (not counted)</description>
  </rule>

  <!-- Counted: operations that fetch message or contact content, in the
       account's own session (3.1: not Zimbra's own tools, and not a
       delegated session, which 100895 takes). -->
  <rule id="100971" level="1">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:GetMsgRequest|GetConvRequest|ExportContactsRequest|GetContactsRequest|SearchGalRequest)$</action>
    <match type="pcre2">^(?![^\[]*\[\S*\] \[(?:name=zimbra;|name=[^;\[\]]*;aname=zimbra;)(?:(?:o?ip=(?:::ffff:)?(?:10\.|127\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.)|(?!o?ip=)\w+=)(?:[^;\[\]]|;;)*;)*?ua=(?:zm[a-z]+|ZCS)[/;])(?![^\[]*\[\S*\] \[(?:name=[^;\[\]]*;)?aname=)</match>
    <options>no_log</options>
    <description>Zimbra content-read SOAP operation, counted for correlation: $(action) by $(dstuser)</description>
    <group>zimbra_soap_read,</group>
  </rule>

  <!-- Counted: searches, except Z-Push's folder listing on every sync. -->
  <rule id="100929" level="1">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:SearchRequest|SearchConvRequest)$</action>
    <match type="pcre2">^(?![^\[]*\[\S*\] \[(?:name=zimbra;|name=[^;\[\]]*;aname=zimbra;)(?:(?:o?ip=(?:::ffff:)?(?:10\.|127\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.)|(?!o?ip=)\w+=)(?:[^;\[\]]|;;)*;)*?ua=(?:zm[a-z]+|ZCS)[/;])(?![^\[]*\[\S*\] \[(?:name=[^;\[\]]*;)?aname=)(?![^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*?ua=(?:[^;]|;;)*?ZPZB/)</match>
    <options>no_log</options>
    <description>Zimbra search SOAP operation, counted for correlation: $(action) by $(dstuser)</description>
    <group>zimbra_soap_read,</group>
  </rule>

  <!-- An administrator reading another account's mailbox through a
       delegated session: the line names the mailbox (name=) and the
       administrator (aname=).
       3.1: such a session from a private address is an administrator
       working, or an internal tool holding an admin token (measured: one
       tool read 1,788 messages of one mailbox in 8.8 days, which raised
       100972/100973 1.3 times a day and could only be silenced by listing
       its account). It is now reported once for each (administrator,
       mailbox, address) triple (100897), and many different mailboxes in an
       hour raise 100899. From a public address it is counted for 100972 as
       before (100898). -->
  <rule id="100895" level="1">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:GetMsgRequest|GetConvRequest|ExportContactsRequest|GetContactsRequest|SearchGalRequest|SearchRequest|SearchConvRequest)$</action>
    <match type="pcre2">^(?![^\[]*\[\S*\] \[(?:name=zimbra;|name=[^;\[\]]*;aname=zimbra;)(?:(?:o?ip=(?:::ffff:)?(?:10\.|127\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.)|(?!o?ip=)\w+=)(?:[^;\[\]]|;;)*;)*?ua=(?:zm[a-z]+|ZCS)[/;])(?=[^\[]*\[\S*\] \[(?:name=[^;\[\]]*;)?aname=)</match>
    <options>no_log</options>
    <description>Zimbra mailbox read in a delegated administrator session: $(zimbra.aname) reading $(dstuser)</description>
  </rule>

  <rule id="100898" level="1">
    <if_sid>100895</if_sid>
    <srcip negate="yes">10.0.0.0/8</srcip>
    <srcip negate="yes">172.16.0.0/12</srcip>
    <srcip negate="yes">192.168.0.0/16</srcip>
    <srcip negate="yes">127.0.0.0/8</srcip>
    <srcip negate="yes">100.64.0.0/10</srcip>
    <srcip negate="yes">fc00::/7</srcip>
    <srcip negate="yes">fe80::/10</srcip>
    <list field="srcip" lookup="not_address_match_key">etc/lists/zimbra-internal-networks</list>
    <options>no_log</options>
    <description>Delegated mailbox read from a public address, counted for correlation: $(zimbra.aname) reading $(dstuser) from: $(srcip)</description>
    <group>zimbra_soap_read,</group>
  </rule>

  <rule id="100897" level="5">
    <if_sid>100895</if_sid>
    <srcip>10.0.0.0/8</srcip>
    <srcip>172.16.0.0/12</srcip>
    <srcip>192.168.0.0/16</srcip>
    <srcip>127.0.0.0/8</srcip>
    <srcip>100.64.0.0/10</srcip>
    <srcip>fc00::/7</srcip>
    <srcip>fe80::/10</srcip>
    <if_fts />
    <description>A Zimbra administrator is reading another account's mailbox, first time from this address: $(zimbra.aname) reading $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1114.002</id>
    </mitre>
  </rule>

  <rule id="100899" level="12" frequency="5" timeframe="3600">
    <if_matched_sid>100897</if_matched_sid>
    <same_field>zimbra.aname</same_field>
    <description>[HIGH] One Zimbra administrator began reading five or more different mailboxes within an hour: $(zimbra.aname) from: $(srcip)</description>
    <mitre>
      <id>T1114.002</id>
    </mitre>
    <group>exfiltration,</group>
  </rule>

  <!-- Same account, many reads in five minutes. Counted per account, not
       per address: everyone behind Z-Push or a proxy shares an address. -->
  <rule id="100972" level="12" frequency="30" timeframe="300">
    <if_matched_group>zimbra_soap_read</if_matched_group>
    <same_user />
    <description>[HIGH] Zimbra account read a large volume of message content in a short window, suggesting automated harvesting: $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1114</id>
    </mitre>
    <group>exfiltration,</group>
  </rule>

  <!-- Three times the 100972 threshold: 100972 fires every 30 reads, so a
       third 100972 for the account within five minutes is 90 reads. (As a
       sibling with frequency 90, 100972 always took the event first.) -->
  <rule id="100973" level="14" frequency="3" timeframe="300">
    <if_matched_sid>100972</if_matched_sid>
    <same_user />
    <description>[HIGH] Zimbra account read an extreme volume of message content, strongly suggesting data theft: $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1114</id>
    </mitre>
    <group>exfiltration,</group>
  </rule>

  <!-- Optional tuning: accounts listed in etc/lists/zimbra-service-accounts
       (an archiver, a probe using its own account) are expected to read a
       lot. Nothing is listed by default and nothing needs to be. For a
       delegated session the lookup is on the administrator (srcuser). -->
  <rule id="100974" level="0">
    <if_sid>100972,100973</if_sid>
    <list field="user" lookup="match_key">etc/lists/zimbra-service-accounts</list>
    <description>Bulk reading by a listed Zimbra service account (excluded)</description>
  </rule>

  <!-- The old 100935 (the same for the aname= of a delegated session; 3.3
       reuses the ID for 100935 below) is removed in 3.1: 100974 already covers it, because a CDB lookup on "user" checks
       srcuser first and the decoder now puts aname= there (tested). -->

  <!-- Sending: webmail and Z-Push both send with SendMsgRequest. -->
  <rule id="100928" level="1">
    <if_sid>100970</if_sid>
    <action>SendMsgRequest</action>
    <options>no_log</options>
    <description>Zimbra mail send event, counted for correlation</description>
  </rule>

  <rule id="100925" level="12" frequency="50" timeframe="300">
    <if_matched_sid>100928</if_matched_sid>
    <same_user />
    <description>[HIGH] One account sent a large volume of mail in a short window, the account may be hijacked: $(dstuser)</description>
    <mitre>
      <id>T1114.002</id>
    </mitre>
  </rule>

  <!-- Two-factor and application passwords. An application password is a
       way around two-factor login; generating one is how a session thief
       keeps access after the session ends. -->
  <rule id="100851" level="12">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:EnableTwoFactorAuth|DisableTwoFactorAuth|GenerateScratchCodes|CreateAppSpecificPassword|RevokeAppSpecificPassword|RevokeTrustedDevice)Request$</action>
    <description>[HIGH] Two-factor settings changed, backup codes or an application password generated: $(action) by $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1556.006</id>
    </mitre>
  </rule>

  <!-- Mail filter rules saved. Forwarding or deleting rules are the usual
       trace of a business-mail compromise (the polling rules 100883/100884
       see the result later; this sees the change when it happens).
       3.2: level 5 to 7. The stored XSS exploited through CVE-2025-27915
       (CISA KEV 2025-10-07, calendar invitations) saved a filter that
       redirected the victim's mail; none in 9 days on two servers. -->
  <rule id="100930" level="7">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:ModifyFilterRules|ModifyOutgoingFilterRules)Request$</action>
    <description>Zimbra mail filter rules changed: $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1564.008</id>
      <id>T1114.003</id>
    </mitre>
    <group>zimbra_mailflow_change,</group>
  </rule>

  <!-- 3.2: a sending identity created or changed (the From name, the
       reply-to address, a send-as persona): how a mailbox taken over is
       made to answer for its owner. -->
  <rule id="100814" level="3">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:CreateIdentity|ModifyIdentity)Request$</action>
    <match type="pcre2">^(?![^\[]*\[\S*\] \[(?:name=zimbra;|name=[^;\[\]]*;aname=zimbra;)(?:(?:o?ip=(?:::ffff:)?(?:10\.|127\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.)|(?!o?ip=)\w+=)(?:[^;\[\]]|;;)*;)*?ua=(?:zm[a-z]+|ZCS)[/;])</match>
    <description>Zimbra sending identity created or changed: $(action) by $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>zimbra_mailflow_change,</group>
  </rule>

  <!-- 3.2: preferences saved. This is also how a user sets forwarding
       ("Forward a copy to"), but the web client saves preferences for
       ordinary settings too (sort order, reading pane), and mailbox.log
       does not say which: recorded only, and used by 100816. -->
  <rule id="100815" level="2">
    <if_sid>100970</if_sid>
    <action>ModifyPrefsRequest</action>
    <match type="pcre2">^(?![^\[]*\[\S*\] \[(?:name=zimbra;|name=[^;\[\]]*;aname=zimbra;)(?:(?:o?ip=(?:::ffff:)?(?:10\.|127\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.)|(?!o?ip=)\w+=)(?:[^;\[\]]|;;)*;)*?ua=(?:zm[a-z]+|ZCS)[/;])</match>
    <description>Zimbra preferences saved: $(dstuser) from: $(srcip)</description>
    <group>zimbra_mailflow_change,</group>
  </rule>


  <rule id="100932" level="3">
    <if_sid>100970</if_sid>
    <action>ChangePasswordRequest</action>
    <description>Zimbra account password changed by its user: $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- Changes made in the admin console (or with any admin token), not by
       Zimbra's own command-line tools. -->
  <rule id="100931" level="8">
    <if_sid>100970</if_sid>
    <url type="pcre2">^https?://\S*/service/admin/soap</url>
    <action type="pcre2">^(?:CreateAccount|DeleteAccount|RenameAccount|SetPassword|ModifyAccount|AddAccountAlias|GrantRight|RevokeRight|ModifyConfig|ModifyCos|ModifyDomain|CreateDomain|DeployZimlet|UndeployZimlet|ModifyZimlet|ModifyServer|CreateDistributionList|AddDistributionListMember|ModifyDistributionList)Request$</action>
    <match type="pcre2">^(?![^\[]*\[\S*\] \[(?:name=zimbra;|name=[^;\[\]]*;aname=zimbra;)(?:(?:o?ip=(?:::ffff:)?(?:10\.|127\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.)|(?!o?ip=)\w+=)(?:[^;\[\]]|;;)*;)*?ua=(?:zm[a-z]+|ZCS)[/;])</match>
    <description>Zimbra administrative change: $(action) by $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_changed,</group>
  </rule>

  <!-- 3.3: the password-reset recovery address set or verified
       (SetRecoveryAccountRequest, service/mail/SetRecoveryAccount.java,
       10.1.20: whoever reads that mailbox can reset the password) or rights
       on the account granted (GrantRightsRequest in the account namespace:
       send-as, send-on-behalf-of, free/busy and invitation rights for
       another account, a group, a domain or everyone). mailbox.log names
       only the operation, not the right or the grantee. None in ten days
       on two servers. -->
  <rule id="100935" level="5">
    <if_sid>100970</if_sid>
    <action type="pcre2">^(?:SetRecoveryAccount|GrantRights)Request$</action>
    <match type="pcre2">^(?![^\[]*\[\S*\] \[(?:name=zimbra;|name=[^;\[\]]*;aname=zimbra;)(?:(?:o?ip=(?:::ffff:)?(?:10\.|127\.|192\.168\.|172\.(?:1[6-9]|2\d|3[01])\.|100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.)|(?!o?ip=)\w+=)(?:[^;\[\]]|;;)*;)*?ua=(?:zm[a-z]+|ZCS)[/;])</match>
    <description>Zimbra account recovery address or delegated rights changed: $(action) by $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>zimbra_mailflow_change,</group>
  </rule>

  <!-- 3.2: the account-takeover sequence: a login from a public address
       this account had never used (100837, level 5), then within 30
       minutes a change by the same account that keeps the attacker in or
       the owner out; the shape of the CVE-2025-27915 and CVE-2023-37580
       payloads and of a phished password. A phone (Z-Push) saving its
       settings is not counted. In practice the window is as long as the
       manager's correlation memory lasts (8,192 events). Level 12 is above
       the level 5 it correlates with (4.14.7 skips events matched at or
       above the correlating rule's level).
       3.3: also a password change (100932), two-factor turned off, backup
       codes or an application password made (100851), and a new recovery
       address or delegated rights (100935); defined after them, because
       4.14.7 drops an if_sid that names a rule loaded later. -->
  <rule id="100816" level="12" timeframe="1800">
    <if_sid>100930,100814,100815,100932,100851,100935</if_sid>
    <if_matched_sid>100837</if_matched_sid>
    <same_user />
    <match type="pcre2">^(?![^\[]*\[\S*\] \[(?:\w+=(?:[^;]|;;)*;)*?ua=(?:[^;]|;;)*?ZPZB/)</match>
    <description>[HIGH] Zimbra account changed its mail filters, identity, preferences, password, two-factor or recovery settings right after its first login from a new public address, possible account takeover: $(action) by $(dstuser) from: $(srcip)</description>
    <mitre>
      <id>T1078</id>
      <id>T1098</id>
      <id>T1114.003</id>
      <id>T1564.008</id>
    </mitre>
    <group>credential_access,</group>
  </rule>

</group>

<!-- ==========================================================
     3.2: ZimbraInvalidLoginFilter (mailbox.log, when a server enables it)
     Decoder: zimbra-invalid-login-filter (0002-zimbra_mailbox_decoders.xml)
     The filter refuses every request from an address after
     zimbraInvalidLoginFilterMaxFailedLogin failed logins (default 10) and
     logs one line per refused request, so the alert is raised at most once
     every 30 minutes (ignore is per rule, not per address: a second address
     suspended inside the window is folded into it); every line is recorded
     at level 2. The syslog copy ends at the base rule.
     ========================================================== -->
<group name="zimbra,authentication,">

  <rule id="100817" level="0">
    <decoded_as>zimbra-invalid-login-filter</decoded_as>
    <description>Zimbra invalid-login filter message (base rule)</description>
  </rule>

  <rule id="100805" level="2">
    <if_sid>100817</if_sid>
    <location>/opt/zimbra/log/mailbox.log</location>
    <description>Zimbra refused a request from a suspended address: $(srcip)</description>
    <group>jt_auth_lockout,</group>
  </rule>

  <rule id="100818" level="8" ignore="1800">
    <if_sid>100805</if_sid>
    <description>Zimbra suspended an address after repeated failed logins (ZimbraInvalidLoginFilter): $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,jt_auth_lockout,</group>
  </rule>

</group>
