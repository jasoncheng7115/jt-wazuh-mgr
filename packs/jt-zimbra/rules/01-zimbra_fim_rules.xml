<!--
  Zimbra FIM（檔案完整性）偵測規則
  檔案：/var/ossec/etc/rules/zimbra_fim_rules.xml
  區段：100800-100819
  版本：v2.0

  相依：
    - CDB 清單 etc/lists/zimbra-webfiles（須於 ossec.conf <ruleset> 宣告）
    - Agent 端 syscheck 須設定 whodata="yes"（需 auditd）

  內建父規則等級（Wazuh 4.14 實測）：
    550 = 內容異動 level 7 / 553 = 刪除 level 7 / 554 = 新增 level 5

  ※ FIM 規則欄位名稱必須使用「規則欄位名」而非 JSON 輸出名：
     file / changed_fields / changed_content / process_name /
     effective_name / audit_name / uname
     使用 audit.process.name、changed_attributes 等 JSON 名稱會靜默失效。
-->
<group name="zimbra,syscheck,">

  <!-- 基礎規則：Zimbra Web 與擴充目錄的任何檔案異動 -->
  <rule id="100800" level="0">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/opt/zimbra/(jetty_base|jetty)/webapps/|^/opt/zimbra/lib/ext/</field>
    <description>Zimbra web or extension directory file change (base rule)</description>
  </rule>

  <!-- 原廠檔案：升級時的正常行為，降噪 -->
  <rule id="100801" level="0">
    <if_sid>100800</if_sid>
    <list field="file" lookup="match_key">etc/lists/zimbra-webfiles</list>
    <description>Zimbra stock file changed, normal during an upgrade</description>
  </rule>

  <!-- 核心規則：非原廠可執行檔案 = 高度疑似 Web Shell -->
  <rule id="100802" level="14">
    <if_sid>100800</if_sid>
    <field name="file" type="pcre2">\.(jsp|jspx|class|war|jar)$</field>
    <list field="file" lookup="not_match_key">etc/lists/zimbra-webfiles</list>
    <description>[HIGH] Non-stock executable file in the Zimbra web directory, strongly suggests a web shell: $(file)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>webshell,pci_dss_11.5,gdpr_II_5.1.f,</group>
  </rule>

  <!-- whodata：補上「誰寫的」—— 釐清入侵管道的唯一依據 -->
  <rule id="100803" level="15">
    <if_sid>100802</if_sid>
    <field name="process_name" type="pcre2">.+</field>
    <description>[CRITICAL] Web shell dropped: $(file) written by: $(process_name) user: $(effective_name)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>webshell,</group>
  </rule>

  <!-- lib/ext：Java 擴充後門，比 JSP webshell 更危險 -->
  <rule id="100806" level="15">
    <if_sid>100800</if_sid>
    <field name="file" type="pcre2">^/opt/zimbra/lib/ext/</field>
    <list field="file" lookup="not_match_key">etc/lists/zimbra-webfiles</list>
    <description>[CRITICAL] Non-stock module in the Zimbra Java extension directory, can hijack authentication and steal cleartext passwords: $(file)</description>
    <mitre>
      <id>T1505</id>
    </mitre>
    <group>webshell,backdoor,</group>
  </rule>

  <!--
    暫存目錄出現攻擊者工具，依「需不需要執行權限」拆成兩條。

    2026-09-09 實測：原本這是一條規則，涵蓋 jsp 到 elf 全部副檔名且不檢查權限。
    在一台開發主機上 15 天產生 6,133 筆 level 12，其中 5,538 筆是 .py ——
    多數是原始碼，根本沒有執行權限位元，永遠不可能被直接執行。

    判別式是「這個副檔名要不要 x 位元才跑得起來」：
      100807  jsp / jspx / class / jar / war —— 由容器載入，不看檔案權限。
      100809  sh / py / pl / elf / bin       —— 要有 x 位元才是可執行的東西。
    實測：0755 的 .py 命中 100809，0644 的同名檔案靜默。

    ★ 這兩條規則雖然放在 Zimbra 的規則檔裡，**卻沒有任何 Zimbra 範圍限制**，
      對所有 agent 都會生效。而且因為 `01-` 比 `zz-` 早載入，
      它們會蓋掉 jt-portable-detect 的 906202（同一個事件只會命中先載入的那條）。
      兩個套件都裝的話，暫存目錄的告警是由這裡發出的，不是 906202。
  -->
  <rule id="100807" level="12">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/(tmp|var/tmp|dev/shm)/.*\.(jsp|jspx|class|jar|war)$</field>
    <description>[HIGH] Web application artefact in a temporary directory, possible attacker tooling: $(file) process: $(process_name)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>attack_tool,</group>
  </rule>

  <rule id="100809" level="12">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/(tmp|var/tmp|dev/shm)/.*\.(sh|py|pl|elf|bin)$</field>
    <field name="perm" type="pcre2">x</field>
    <description>[HIGH] Executable script or binary in a temporary directory, possible attacker tooling: $(file) process: $(process_name)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>attack_tool,</group>
  </rule>

  <!--
    建置與測試工具鏈的暫存目錄。

    2026-09-16 實測：一台共用建置主機一天之內讓 100809 產生 399 筆 level 12，
    佔全站 level 12 以上告警的 91%，把同一天真正的偵測（掃描器探測反向代理
    的組態檔）整個蓋掉。那 399 筆全部是建置腳本：0755、屬於建置帳號、
    由剛剛才建立那個目錄的測試流程寫進去。

    這條規則涵蓋的是跨站台穩定的工具鏈慣例，不是站台自己的目錄名 ——
    那台主機上有 116 個這種目錄，名字由寫 CI 腳本的人各自決定，
    用前綴清單永遠追不完。站台自己的路徑請另外寫一條規則，
    放在自己的檔案裡，這樣套件升級才不會蓋掉。

    ★ 這個樣式與 jt-portable-detect 的規則 906234 是同一份，必須同步維護。
      兩個套件可以各自獨立安裝，所以無法共用一條規則；
      preflight 的 build scratch pattern 檢查會擋住兩邊走樣。
  -->
  <rule id="100810" level="0">
    <if_sid>100807,100809</if_sid>
    <field name="file" type="pcre2">^/(tmp|var/tmp)/(pytest-of-|pytest-|tox-|pip-|virtualenv-|go-build|cargo-|rustc|npm-|yarn--|node-compile-cache|v8-compile-cache|bazel|gradle|maven-|mvn|sbt_|ccache|cmake-|meson-|conan|jenkins|gitlab-runner|actions-runner|buildkite|cabal-|stack-)</field>
    <description>Build or test toolchain scratch directory (normal)</description>
  </rule>

  <!-- 原廠檔案「內容」遭竄改（不是新增，是既有檔案被改寫） -->
  <rule id="100808" level="13">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/opt/zimbra/(jetty_base|jetty)/webapps/</field>
    <list field="file" lookup="match_key">etc/lists/zimbra-webfiles</list>
    <field name="changed_fields" type="pcre2">md5|sha1|sha256</field>
    <description>[HIGH] Zimbra stock file contents were tampered with: $(file) process: $(process_name)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>webshell,</group>
  </rule>

</group>
