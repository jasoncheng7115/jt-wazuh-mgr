<!--
  Zimbra auditd 程序層偵測規則
  檔案：/var/ossec/etc/rules/zimbra_audit_rules.xml
  區段：100860-100879
  版本：v2.0

  相依：Agent 端 /etc/audit/rules.d/zimbra.rules（見 agent/audit/zimbra.rules）
  父規則：80700（auditd 事件）

  ※ audit.key / audit.exe / audit.uid 為 auditd 解碼器的「動態欄位」，
    使用 <field name="..."> 正確（與 FIM 的欄位命名規則不同）。
-->
<group name="zimbra,audit,">

  <rule id="100860" level="13">
    <if_sid>80700</if_sid>
    <field name="audit.key">zimbra_recon</field>
    <description>[HIGH] The zimbra service account ran a system reconnaissance command, suggesting web shell activity: $(audit.exe)</description>
    <mitre>
      <id>T1033</id>
    </mitre>
  </rule>

  <rule id="100861" level="15">
    <if_sid>80700</if_sid>
    <field name="audit.key">zimbra_tool</field>
    <description>[CRITICAL] The zimbra service account ran a network tool, suggesting a reverse shell or data exfiltration: $(audit.exe)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100862" level="14">
    <if_sid>80700</if_sid>
    <field name="audit.key">zimbra_webdir</field>
    <field name="audit.exe" type="pcre2">^(?!/opt/zimbra/).*</field>
    <description>[HIGH] A non-Zimbra process wrote to the web directory: $(audit.exe)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
  </rule>

  <rule id="100863" level="15">
    <if_sid>80700</if_sid>
    <field name="audit.key">zimbra_jvm</field>
    <description>[CRITICAL] JVM injection tool executed, suggesting an in-memory implant: $(audit.exe)</description>
    <mitre>
      <id>T1055</id>
    </mitre>
    <group>memory_shell,</group>
  </rule>

  <rule id="100864" level="14">
    <if_sid>80700</if_sid>
    <field name="audit.key">zimbra_antiforensics</field>
    <description>[HIGH] Anti-forensic activity detected, timestamp forgery or login record tampering: $(audit.exe)</description>
    <mitre>
      <id>T1070</id>
    </mitre>
  </rule>

  <rule id="100865" level="14">
    <if_sid>80700</if_sid>
    <field name="audit.key">zimbra_startup|zimbra_config</field>
    <description>[HIGH] Zimbra startup script or core configuration modified, suggesting persistence: $(audit.exe)</description>
    <mitre>
      <id>T1543</id>
    </mitre>
  </rule>

</group>
