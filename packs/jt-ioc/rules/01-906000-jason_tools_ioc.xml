  <!-- ===== JSON web access logs (remote_addr, client_ip) =====
    Measured 2026-10-06 (1.2): one reverse proxy, a week, 29,845 level 12
    alerts, 98.5 per cent of the public addresses it logged, nearly all of them
    scanners getting a 404. 2026-10-08 (1.4): 49 level 12 alerts were cloud
    addresses fetching /login and /admin from a single-page application that
    answers 200 to every path. A page view proves nothing either way; what the
    listed address managed to change does.
    The grading reads http_status, method and path (common JSON access log names).
  -->
  <rule id="906023" level="3">
    <if_sid>1</if_sid>
    <list field="remote_addr" lookup="address_match_key">etc/lists/jason_tools_threat_ip</list>
    <description>jt-ioc: web request from a threat-listed address - $(remote_addr)</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>threat_intelligence,ioc_web,</group>
  </rule>

  <rule id="906024" level="3">
    <if_sid>1</if_sid>
    <list field="data.remote_addr" lookup="address_match_key">etc/lists/jason_tools_threat_ip</list>
    <description>jt-ioc: web request from a threat-listed address - $(data.remote_addr)</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>threat_intelligence,ioc_web,</group>
  </rule>

  <rule id="906025" level="3">
    <if_sid>1</if_sid>
    <list field="client_ip" lookup="address_match_key">etc/lists/jason_tools_threat_ip</list>
    <description>jt-ioc: web request from a threat-listed address - $(client_ip)</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>threat_intelligence,ioc_web,</group>
  </rule>

  <rule id="906026" level="3">
    <if_sid>1</if_sid>
    <list field="data.client_ip" lookup="address_match_key">etc/lists/jason_tools_threat_ip</list>
    <description>jt-ioc: web request from a threat-listed address - $(data.client_ip)</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>threat_intelligence,ioc_web,</group>
  </rule>

  <!-- Refused, redirected or not found: the address got nothing. Recorded for 906042/906043. -->
  <rule id="906040" level="2">
    <if_sid>906023,906024,906025,906026</if_sid>
    <field name="http_status" type="pcre2">^(30[0-8]|4\d\d)$</field>
    <description>jt-ioc: threat-listed address was refused by the web server ($(http_status))</description>
    <group>threat_intelligence,ioc_web,web_scan,</group>
  </rule>

  <!-- Static content only (a crawler). -->
  <rule id="906041" level="2">
    <if_sid>906023,906024,906025,906026</if_sid>
    <field name="http_status" type="pcre2">^2\d\d$</field>
    <field name="method" type="pcre2">^(GET|HEAD)$</field>
    <field name="path" type="pcre2">(?i)(^/$|\.(html?|webp|png|jpe?g|gif|svg|css|js|ico|woff2?|xml|txt)(\?|$))</field>
    <description>jt-ioc: threat-listed address fetched static content only</description>
    <group>threat_intelligence,ioc_web,</group>
  </rule>

  <!-- A write the server accepted: a form, an API call, an upload. -->
  <rule id="906044" level="6">
    <if_sid>906023,906024,906025,906026</if_sid>
    <field name="http_status" type="pcre2">^2\d\d$</field>
    <field name="method" type="pcre2">^(POST|PUT|PATCH|DELETE)$</field>
    <description>jt-ioc: web server accepted a $(method) from a threat-listed address - $(path)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>threat_intelligence,ioc_web,</group>
  </rule>

  <rule id="906045" level="12">
    <if_sid>906044</if_sid>
    <list field="remote_addr" lookup="address_match_key">etc/lists/jason_tools_threat_ip_high</list>
    <description>[HIGH] jt-ioc: web server accepted a $(method) from an address listed by several threat feeds - $(remote_addr) $(path)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>threat_intelligence,ioc_web,ioc_high,</group>
  </rule>

  <rule id="906046" level="12">
    <if_sid>906044</if_sid>
    <list field="client_ip" lookup="address_match_key">etc/lists/jason_tools_threat_ip_high</list>
    <description>[HIGH] jt-ioc: web server accepted a $(method) from an address listed by several threat feeds - $(client_ip) $(path)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>threat_intelligence,ioc_web,ioc_high,</group>
  </rule>

  <!-- Keep the "scanning now" signal: thirty refusals for one address in ten
       minutes. One rule per field, and the event that completes the count must
       carry the listed address in that field: a log with both fields (a CDN
       edge in client_ip, the visitor in remote_addr) counted the wrong one. -->
  <rule id="906043" level="6" frequency="30" timeframe="600" ignore="1800">
