  <!-- 出站連線到惡意 IP (更高風險) -->
  <rule id="906080" level="14">
    <if_sid>906011,906012,906013,906014,906015,906016,906017</if_sid>
    <description>[HIGH] Jason Tools IOC: CRITICAL - Outbound connection to malicious IP detected</description>
    <mitre>
      <id>T1071</id>
      <id>TA0011</id>
    </mitre>
    <group>threat_intelligence,critical_threat,outbound_malicious,outbound_threat,network_threat,command_and_control,</group>
  </rule>

  <!-- Sysmon 處理程序連線到惡意 IP (特別標註處理程序資訊) -->
  <rule id="906081" level="14">
    <if_sid>906032,906034</if_sid>
    <description>[HIGH] Jason Tools IOC: CRITICAL - Sysmon detected process connecting to malicious IP - $(data.win.eventdata.destinationIp)$(data.win.eventdata.destinationip) | Process: $(data.win.eventdata.image)</description>
    <mitre>
      <id>T1071</id>
      <id>TA0011</id>
    </mitre>
    <group>threat_intelligence,sysmon,windows,endpoint_detection,critical_threat,process_connection,outbound_threat,network_threat,command_and_control,</group>
  </rule>

  
