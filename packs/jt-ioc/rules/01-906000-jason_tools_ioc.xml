<!--
  Jason Tools IOC 檢測規則
  檔案名稱: 01-906000-jason_tools_ioc.xml
  目的: 使用多來源威脅情資進行 IP 黑名單檢測
  CDB 路徑: etc/lists/jason_tools_threat_ip
  來源: blocklist.de 系列, CINS Army, Maltrail, Matthew Roberts, net_ua
  專注: 常見的來源和目的 IP 欄位格式比對
  
  MITRE ATT&CK 對應：
  - T1595: 主動掃描 (入站掃描)
  - T1071: 應用層協定 (應用層協定通訊)
  - T1071.004: DNS (DNS 通道)
  - TA0011: 命令與控制 (Command and Control)
-->

<group name="jason_tools_ioc,">
  
  <!-- ===== 來源 IP 檢測 (Source IP) ===== -->
  
  <!-- srcip - 最常見的來源 IP 欄位 -->
  <rule id="906001" level="12">
    <if_sid>1</if_sid>
    <list field="srcip" lookup="address_match_key">etc/lists/jason_tools_threat_ip</list>
    <description>[HIGH] Jason Tools IOC: Malicious source IP - $(srcip)</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>threat_intelligence,malicious_srcip,inbound_threat,network_threat,</group>
  </rule>

  <!-- data.srcip - 常見於結構化日誌 -->
  <rule id="906002" level="12">
