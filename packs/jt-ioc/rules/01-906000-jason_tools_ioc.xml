    <list field="data.win.eventdata.queryResults" lookup="address_match_key">etc/lists/jason_tools_threat_ip</list>
    <description>[HIGH] Jason Tools IOC: Sysmon DNS query returned malicious IP - $(data.win.eventdata.queryResults)</description>
    <mitre>
      <id>T1071.004</id>
      <id>TA0011</id>
    </mitre>
    <group>threat_intelligence,sysmon,windows,endpoint_detection,dns_query,malicious_ip,command_and_control,</group>
