    <list field="data.srcip" lookup="address_match_key">etc/lists/jason_tools_threat_ip</list>
    <description>[HIGH] Jason Tools IOC: Malicious source IP - $(data.srcip)</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>threat_intelligence,malicious_srcip,inbound_threat,network_threat,</group>
  </rule>

