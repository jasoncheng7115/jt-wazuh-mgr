  <!--
    ══════════════════════════════════════════════════════════════════════
     2026-10-06（套件 1.3）：以下為重新設計的部分
    ══════════════════════════════════════════════════════════════════════

    上方以 if_sid 1 掛載的規則，只在事件剛好走到內建規則 1（syslog 通用範本）
    底下時才會比對。實測 30 天：sshd 等有自己規則鏈的事件不會到這裡，Windows
    事件也不會，整個套件實際上只有網站存取記錄的 remote_addr（906023）在觸發。
    而那一條在一週內觸發近三萬次 —— 清單有 26 萬個位址，以整批掃描器網段為主，
    「清單裡的位址來連網站」幾乎就是「網路上的任何掃描」，本身不是訊號。

    所以這一段把比對掛到真正有意義的地方：
      906040-906043  網站請求依結果分級（被拒的不寄信，大量掃描才關聯告警）
      906050-906051  清單裡的位址「成功登入」── 掛在 authentication_success 群組
      906031-906032  Windows 主機與清單位址的連線 ── 掛在 Sysmon 事件 3
      （後兩組在另一個檔案 zz-906050-…，必須晚於內建規則載入）
    原本的 906031-906035、906081 從未觸發過（欄位名稱多了 data.、父規則是規則 1），
    已移除或改寫。
  -->

  <!-- 網站請求：被拒、被導向或沒找到 —— 對方什麼都沒拿到。記錄但不寄信。 -->
  <rule id="906040" level="5">
    <if_sid>906023,906024,906025,906026</if_sid>
    <field name="http_status" type="pcre2">^(30[0-8]|4\d\d)$</field>
    <description>Jason Tools IOC: threat-listed address was refused by the web server ($(http_status))</description>
    <group>threat_intelligence,web_scan,</group>
  </rule>

  <!-- 只抓了靜態內容（爬蟲型）：同樣不寄信。 -->
  <rule id="906041" level="6">
    <if_sid>906023,906024,906025,906026</if_sid>
    <field name="http_status" type="pcre2">^2\d\d$</field>
    <field name="method" type="pcre2">^(GET|HEAD)$</field>
    <field name="path" type="pcre2">(?i)(^/$|\.(html?|webp|png|jpe?g|gif|svg|css|js|ico|woff2?|xml|txt)(\?|$))</field>
    <description>Jason Tools IOC: threat-listed address fetched static content only</description>
    <group>threat_intelligence,</group>
  </rule>

  <!-- 保留「正在掃描」的訊號：同一位址 10 分鐘內被拒 30 次。父規則是 level 5，
       不會碰到 level 0 不能做關聯的問題。 -->
  <rule id="906043" level="10" frequency="30" timeframe="600" ignore="1800">
    <if_matched_sid>906040</if_matched_sid>
    <same_field>remote_addr</same_field>
    <description>[WARN] Jason Tools IOC: threat-listed address is actively scanning the web server</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>threat_intelligence,web_scan,</group>
  </rule>

  <!-- 906050/906051（成功登入）與 906031/906032（Windows 連線）在
       zz-906050-jason_tools_ioc_late.xml，原因見該檔檔頭。 -->

