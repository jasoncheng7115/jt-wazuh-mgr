  <!--
    Datastore disk usage, from the "df -P" command in every Linux agent's
    default configuration (every 6 minutes). PBS stops accepting backups when
    a datastore is full, and garbage collection needs free space to run.
    Mount points under /mnt/datastore/ (where PBS mounts the disks it formats,
    and removable datastores) are watched without configuration; list other
    mount points that hold a datastore (a ZFS pool, an NFS share) in
    etc/lists/jt-pbs-datastore-mounts. The built-in rule 531 looks only at
    /dev/ devices at 100 per cent, and its child 532 drops any mount whose path
    contains "usb" or "/mount"; the rules below are children of both, so they
    still apply. Each alert repeats at most every 6 hours.
  -->
  <rule id="131890" level="0">
    <if_sid>530,531,532</if_sid>
    <field name="pbs.mount" type="pcre2">^/mnt/datastore/</field>
    <description>Proxmox Backup Server: usage of datastore filesystem $(pbs.mount)</description>
  </rule>

  <rule id="131891" level="0">
    <if_sid>530,531,532</if_sid>
    <list field="pbs.mount" lookup="match_key">etc/lists/jt-pbs-datastore-mounts</list>
    <description>Proxmox Backup Server: usage of datastore filesystem $(pbs.mount)</description>
  </rule>

  <rule id="131892" level="10" ignore="21600">
    <if_sid>131890,131891</if_sid>
    <field name="pbs.usage" type="pcre2">^9[0-7]$</field>
    <description>[WARN] Proxmox Backup Server: datastore filesystem $(pbs.mount) is $(pbs.usage)% full</description>
    <group>low_diskspace,</group>
  </rule>

  <rule id="131893" level="12" ignore="21600">
    <if_sid>131890,131891</if_sid>
    <field name="pbs.usage" type="pcre2">^(?:9[89]|100)$</field>
    <description>[HIGH] Proxmox Backup Server: datastore filesystem $(pbs.mount) is $(pbs.usage)% full</description>
    <group>low_diskspace,</group>
  </rule>

</group>
