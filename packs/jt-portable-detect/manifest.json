      "dest": "etc/rules/zz-906200-jt_portable_nix_rules.xml",
      "sha256": "cabaa05629f17fa1dc8bc97b7900b52c7da03d00bdbf5a618141c7bc50ba5fee"
    },
    {
      "type": "list",
      "name": "jt-approved-portable",
