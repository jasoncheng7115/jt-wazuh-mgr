{
  "id": "jt-portable-detect",
  "name": "Portable Executable Detection",
  "name_zh": "可攜式程式偵測",
  "version": "1.3",
  "summary": "Detects portable/no-install executables being dropped and run on Windows, Linux and macOS.",
  "summary_zh": "偵測免安裝執行檔在 Windows、Linux、macOS 上的落地與執行。",
  "rule_id_range": "906100-906299",
  "notes_zh": [
    "Windows 端偵測使用者目錄、非系統碟、Temp 目錄的執行，以及 AppLocker 稽核事件。",
    "Linux/macOS 端偵測權限變更為可執行、暫存目錄落地、AppImage/run/bin 等格式。",
    "已核准的工具請加入 jt-approved-portable 清單（格式 key:approved），加入後降為記錄等級。",
    "Windows 端若要涵蓋『使用者目錄新增執行檔』，agent 的 syscheck 需監控 C:\\Users。"
  ],
  "author": "Jason Tools",
  "license": "Apache-2.0",
  "requires": {
    "wazuh": ">=4.8"
  },
  "files": [
    {
      "type": "rule",
      "name": "zz-906100-jt_portable_rules.xml",
      "dest": "etc/rules/zz-906100-jt_portable_rules.xml",
      "sha256": "2db1a337026a103dd26d26d473c90ae6e5834fb4fa2cbf5e48de3119dead3e67"
    },
    {
