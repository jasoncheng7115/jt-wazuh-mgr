  <!--
    Service failures. A crash writes "Main process exited, code=..." and then
    "Failed with result '...'"; the second line alerts once per failure. The
    first is recorded below the alert level for these units (built-in 40704
    would raise status=1/FAILURE to level 5 as well).
    pmg-smtp-filter, Postfix, clamd, pmgpolicy and PostgreSQL carry the mail.
  -->
  <rule id="132480" level="10">
    <if_sid>40700</if_sid>
    <match type="pcre2">^(?:pmg-smtp-filter|postfix@-|postfix|clamav-daemon|pmgpolicy|postgresql@[\w.-]+)\.service: Failed with result '</match>
    <description>[WARN] PMG: a service that carries the mail failed</description>
    <group>service_availability,</group>
  </rule>

  <rule id="132481" level="7">
    <if_sid>40700</if_sid>
    <match type="pcre2">^(?:pmgproxy|pmgdaemon|pmgmirror|pmgtunnel|pmg-daily|pmg-hourly|pmgspamreport|pmgreport|pmgbanner|clamav-freshclam)\.service: Failed with result '</match>
    <description>PMG: service failed</description>
    <group>service_availability,</group>
  </rule>

  <rule id="132482" level="2">
    <if_sid>40700,40704</if_sid>
    <match type="pcre2">^(?:pmg[\w-]*|postfix@-|clamav-daemon|clamav-freshclam|postgresql@[\w.-]+)\.service: Main process exited, code=</match>
    <description>PMG: a service process exited (the failure is reported once by 132480/132481)</description>
  </rule>

</group>
