<!--
  Zenarmor (OPNsense) detection rules
  ID range: 130800-130899
  Decoder: etc/decoders/zenarmor-decoder.xml (program_name zenarmor, JSON after data=,
  plus srcip / dstip / dstport / zenarmor.index / zenarmor.domain / zenarmor.category).

  What Zenarmor sends
    One record per index: conn, dns, tls, http, sip and alert. A blocked threat
    arrives as SEVERAL records: a DNS block gives a dns record (the query), a
    conn record (the UDP flow to the DNS server) and an alert record; a blocked
    web connection gives conn + tls + alert. The alert record is Zenarmor's own
    block decision: there is exactly one per block, and alertinfo.match.dst_hostname
    holds the name it matched. Measured over 7 days on one site: 1,854 alert
    records, 1,811 dns and 1,816 conn records for the same blocks.
    Alert records can arrive up to about 20 minutes after the conn and dns records.

  Grading
    * Not blocked is worse than blocked: an unblocked malicious connection was
      established (130801, level 12).
    * A blocked CONNECTION (web, any port but 53) is graded per event (130802, 130804).
    * A blocked LOOKUP (port 53) is a quiet base (130816, 130817, level 2) and is
      raised only by its pattern: the same name again and again (130832, beacon)
      or many different names (130833). Measured on the site this was tuned on,
      every blocked lookup came from the internal DNS resolvers and the mail
      gateway, which look names up for other hosts: a mail filter checking the
      domains in a message, or reverse lookups of SMTP clients. 82% of the old
      130802 alerts were one script name in cron mail ("<name>.sh" is a valid TLD)
      tagged Botnet DGA Domains. List such hosts in etc/lists/jt-zenarmor-resolvers.
    * conn / dns / tls records of a blocked threat are duplicates of the alert
      record (130815, level 2). The block needs the Alerts stream; see the setup guide.
    * Weak categories (Proxy, VPN, Parked) stay at level 5 or below, and at level 3
      when the policy blocked them (130828). Generic web-filtering blocks (Ads,
      Social ...) carry no security tag and stay at 130800, level 0.

  Read before changing anything (Wazuh 4.14.7, verified)
    * Sibling rules under one parent are evaluated in an unpredictable order
      (measured in 2026-08 on an earlier version: 130811 -> 130801 -> 130803
      -> 130802 for one parent; 130809-130813 were retired then and are not reused), and the
      first match ends the evaluation. Every sibling set here is mutually
      exclusive: by is_blocked, by index (alert or not), by port (53 or not), by
      CDB lookup (listed or not), or by a negative lookahead on the tag families.
      Version 1.3 had an overlap: "Botnet DGA Domains" matched both the malware
      family (Botnet) and the phishing family (DGA). The phishing family no
      longer lists DGA and excludes events that carry a malware tag.
    * negate="yes" is unreliable. Every exclusion is a positive match: ^0$ / ^1$,
      a pcre2 lookahead, or lookup="not_address_match_key".
    * security_tags is an array; the field value is its JSON text, ["Phishing"].
      Do not anchor a tag regex with ^Phishing$.
    * same_field / different_field need dynamic fields (ip_src_saddr works,
      srcip does not). different_field compares each earlier event with the
      CURRENT one, so two names alternating also count: thresholds allow for it.
    * A frequency rule counts only events whose final rule is the one it names
      (or carries the group it names): events that went on to a quiet child are
      not counted. That is how the resolver lookups stay out of 130832 / 130833.
    * Short words need \b: Tor matches Torrent otherwise.
-->
<group name="zenarmor,">

  <rule id="130800" level="0">
    <match>daemon=zenarmor</match>
    <description>Zenarmor event</description>
    <options>no_full_log</options>
  </rule>

  <!-- ===== Malware, botnet, C2 (security_tags) ===== -->

  <!-- Not blocked: the connection was established. -->
  <rule id="130801" level="12">
    <if_sid>130800</if_sid>
    <field name="security_tags" type="pcre2">(?i)(Malware|Virus|Botnet|C&amp;C|Command.?and.?Control|Ransomware|Trojan|Spyware|\bWorm\b)</field>
    <field name="is_blocked">^0$</field>
    <description>[HIGH] Zenarmor: malicious connection was not blocked - $(security_tags) from: $(srcip) to: $(zenarmor.domain) $(dstip)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,c2,</group>
  </rule>

  <!-- Blocked. After 1.4 this is the final rule only for Zenarmor's alert record of a
       blocked connection on a port other than 53; the duplicates and the lookups go
       to the children below. -->
  <rule id="130802" level="7">
    <if_sid>130800</if_sid>
    <field name="security_tags" type="pcre2">(?i)(Malware|Virus|Botnet|C&amp;C|Command.?and.?Control|Ransomware|Trojan|Spyware|\bWorm\b)</field>
    <field name="is_blocked">^1$</field>
    <description>Zenarmor: malicious connection blocked - $(zenarmor.category) from: $(srcip) to: $(zenarmor.domain) $(dstip):$(dstport)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,blocked,zenarmor_threat_block,</group>
  </rule>

  <!-- ===== Phishing, fraud, spam, mining (security_tags) ===== -->
  <!-- The lookahead keeps an event with a malware tag in the malware family. -->

  <rule id="130803" level="10">
    <if_sid>130800</if_sid>
    <field name="security_tags" type="pcre2">(?i)^(?!.*(Malware|Virus|Botnet|C&amp;C|Command.?and.?Control|Ransomware|Trojan|Spyware|\bWorm\b)).*(Phishing|Crypto.?Mining|Scam|Fraud|Spam)</field>
    <field name="is_blocked">^0$</field>
    <description>[WARN] Zenarmor: phishing or fraud connection was not blocked - $(security_tags) from: $(srcip) to: $(zenarmor.domain) $(dstip)</description>
    <mitre>
      <id>T1566</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,phishing,</group>
  </rule>

  <rule id="130804" level="5">
    <if_sid>130800</if_sid>
    <field name="security_tags" type="pcre2">(?i)^(?!.*(Malware|Virus|Botnet|C&amp;C|Command.?and.?Control|Ransomware|Trojan|Spyware|\bWorm\b)).*(Phishing|Crypto.?Mining|Scam|Fraud|Spam)</field>
    <field name="is_blocked">^1$</field>
    <description>Zenarmor: phishing or fraud connection blocked - $(zenarmor.category) from: $(srcip) to: $(zenarmor.domain) $(dstip):$(dstport)</description>
    <mitre>
      <id>T1566</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,phishing,blocked,zenarmor_threat_block,</group>
  </rule>

  <!-- ===== Blocked threats: one record per block ===== -->

  <!-- conn / dns / tls / http records of a blocked threat. The alert record of the
       same block carries the decision and the matched name. -->
  <rule id="130815" level="2">
    <if_sid>130802,130804</if_sid>
    <field name="zenarmor.index" type="pcre2">^(?!alert$)\w+$</field>
    <description>Zenarmor: $(zenarmor.index) record of a blocked threat, reported by its alert record - from: $(srcip) to: $(zenarmor.domain)</description>
    <options>no_full_log</options>
    <group>zenarmor,blocked,</group>
  </rule>

  <!-- A blocked lookup of a malware or botnet name: a quiet base. -->
  <rule id="130816" level="2">
    <if_sid>130802</if_sid>
    <field name="zenarmor.index">^alert$</field>
    <field name="ip_dst_port">^53$</field>
    <description>Zenarmor: lookup of a malicious domain blocked - $(zenarmor.category) $(zenarmor.domain) from: $(srcip)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,blocked,dns,zenarmor_lookup_block,zenarmor_threat_block,</group>
  </rule>

  <!-- A blocked lookup of a phishing or fraud name: a quiet base. -->
  <rule id="130817" level="2">
    <if_sid>130804</if_sid>
    <field name="zenarmor.index">^alert$</field>
    <field name="ip_dst_port">^53$</field>
    <description>Zenarmor: lookup of a phishing or fraud domain blocked - $(zenarmor.category) $(zenarmor.domain) from: $(srcip)</description>
    <options>no_full_log</options>
    <group>zenarmor,phishing,blocked,dns,zenarmor_lookup_block,zenarmor_threat_block,</group>
  </rule>

  <!-- The lookup came from a host that resolves names for other hosts: an internal
       DNS resolver, a mail filter checking the domains in a message. The firewall
       never sees the client behind it. Counted only by 130834. -->
  <rule id="130818" level="2">
    <if_sid>130816,130817</if_sid>
    <list field="srcip" lookup="address_match_key">etc/lists/jt-zenarmor-resolvers</list>
    <description>Zenarmor: blocked threat lookup made by a listed resolver - $(zenarmor.category) $(zenarmor.domain) via: $(srcip)</description>
    <options>no_full_log</options>
    <group>zenarmor,blocked,dns,zenarmor_resolver_lookup,</group>
  </rule>

  <!-- A command-and-control name, looked up by a client rather than a resolver. -->
  <rule id="130819" level="6">
    <if_sid>130816</if_sid>
    <field name="security_tags" type="pcre2">(?i)(C&amp;C|Command.?and.?Control|\bC2\b|Ransomware|\bBotnet\b(?!\s*DGA))</field>
    <list field="srcip" lookup="not_address_match_key">etc/lists/jt-zenarmor-resolvers</list>
    <description>Zenarmor: lookup of a command-and-control domain blocked - $(zenarmor.category) $(zenarmor.domain) from: $(srcip)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,c2,blocked,dns,zenarmor_lookup_block,zenarmor_threat_block,</group>
  </rule>

  <!-- A blocked connection to a command-and-control server: the host tried to reach
       its controller even though it was stopped. -->
  <rule id="130820" level="10">
    <if_sid>130802</if_sid>
    <field name="zenarmor.index">^alert$</field>
    <field name="ip_dst_port" type="pcre2">^(?!53$)\d+$</field>
    <field name="security_tags" type="pcre2">(?i)(C&amp;C|Command.?and.?Control|\bC2\b|Ransomware|\bBotnet\b(?!\s*DGA))</field>
    <description>[WARN] Zenarmor: connection to a command-and-control server blocked, check the host - $(zenarmor.category) from: $(srcip) to: $(zenarmor.domain) $(dstip):$(dstport)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,c2,blocked,zenarmor_threat_block,</group>
  </rule>

  <!-- ===== Unblocked lookups ===== -->

  <rule id="130821" level="8">
    <if_sid>130801</if_sid>
    <field name="ip_dst_port">^53$</field>
    <description>Zenarmor: a malicious domain was resolved, not blocked - $(security_tags) $(zenarmor.domain) from: $(srcip)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,dns,</group>
  </rule>

  <rule id="130822" level="6">
    <if_sid>130803</if_sid>
    <field name="ip_dst_port">^53$</field>
    <description>Zenarmor: a phishing or fraud domain was resolved, not blocked - $(security_tags) $(zenarmor.domain) from: $(srcip)</description>
    <options>no_full_log</options>
    <group>zenarmor,phishing,dns,</group>
  </rule>

  <rule id="130823" level="4">
    <if_sid>130821,130822</if_sid>
    <field name="zenarmor.index">^dns$</field>
    <list field="srcip" lookup="address_match_key">etc/lists/jt-zenarmor-resolvers</list>
    <description>Zenarmor: a listed resolver resolved a threat domain, not blocked, for a client behind it - $(security_tags) $(zenarmor.domain) via: $(srcip)</description>
    <options>no_full_log</options>
    <group>zenarmor,dns,</group>
  </rule>

  <!-- The UDP flow record of the lookup: its dst_hostname is the DNS server. The
       dns record of the same lookup carries the name. -->
  <rule id="130824" level="2">
    <if_sid>130821,130822</if_sid>
    <field name="zenarmor.index">^conn$</field>
    <description>Zenarmor: flow record of an unblocked threat lookup, reported by its dns record - from: $(srcip) to: $(dstip)</description>
    <options>no_full_log</options>
    <group>zenarmor,dns,</group>
  </rule>

  <!-- ===== Out-of-band testing domains ===== -->
  <!-- interactsh, Burp Collaborator, canarytokens and similar services hand out a
       unique name per payload: a lookup means some host processed an injected
       payload (log4j-style lookups, SSRF, a mail header) or opened a canary. Through
       a resolver it is still meaningful: a host behind it did the processing.
       Measured: a mail gateway resolved one interactsh name 13 times within four
       minutes, which Zenarmor tagged Malware/Virus. -->
  <rule id="130840" level="10">
    <if_sid>130816,130818,130817,130819</if_sid>
    <field name="zenarmor.domain" type="pcre2">(?i)(^|\.)(oast\.(pro|live|site|online|fun|me)|interact\.sh|interactsh\.com|oastify\.com|burpcollaborator\.net|canarytokens\.com|dnslog\.cn|ceye\.io)$</field>
    <description>[WARN] Zenarmor: out-of-band testing domain looked up (blocked), a host processed an injected payload: $(zenarmor.domain) from: $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,oast,blocked,dns,</group>
  </rule>

  <rule id="130841" level="10">
    <if_sid>130821,130822,130823</if_sid>
    <field name="zenarmor.index">^dns$</field>
    <field name="zenarmor.domain" type="pcre2">(?i)(^|\.)(oast\.(pro|live|site|online|fun|me)|interact\.sh|interactsh\.com|oastify\.com|burpcollaborator\.net|canarytokens\.com|dnslog\.cn|ceye\.io)$</field>
    <description>[WARN] Zenarmor: out-of-band testing domain resolved (not blocked), a host processed an injected payload: $(zenarmor.domain) from: $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,oast,dns,</group>
  </rule>

  <!-- ===== Proxy, anonymizer, VPN ===== -->

  <rule id="130805" level="5">
    <if_sid>130800</if_sid>
    <field name="security_tags" type="pcre2">(?i)^(?!.*(Malware|Virus|Botnet|C&amp;C|Command.?and.?Control|Ransomware|Trojan|Spyware|\bWorm\b|Phishing|Crypto.?Mining|Scam|Fraud|Spam)).*(Hacking|Proxy|Anonymizer|\bTor\b|\bVPN\b|Compromised|Suspicious)</field>
    <description>Zenarmor: suspicious or evasive connection - $(security_tags) from: $(srcip) to: $(zenarmor.domain) $(dstip)</description>
    <mitre>
      <id>T1090</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,evasion,</group>
  </rule>

  <!-- category is the web category of a tls record. In practice a record has either
       security_tags or a category, not both. -->
  <rule id="130806" level="5">
    <if_sid>130800</if_sid>
    <field name="category" type="pcre2">(?i)(Hacking|Proxy|Anonymizer|\bTor\b|\bVPN\b)</field>
    <description>Zenarmor: connection in an evasion category - $(category) from: $(srcip) to: $(zenarmor.domain) $(dstip)</description>
    <mitre>
      <id>T1090</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,evasion,</group>
  </rule>

  <!-- An evasion category that the policy blocked: the policy did its job, so this
       is information, below the blocked phishing (5) and malware (7) levels. The
       three quiet rules below are children of this one as well, so a blocked relay
       or allowlisted name still ends at level 2 whichever sibling is tried first. -->
  <rule id="130828" level="3">
    <if_sid>130805,130806</if_sid>
    <field name="is_blocked">^1$</field>
    <description>Zenarmor: evasion-category connection blocked by policy - $(zenarmor.category) from: $(srcip) to: $(zenarmor.domain)</description>
    <options>no_full_log</options>
    <group>zenarmor,evasion,blocked,</group>
  </rule>

  <!-- iCloud Private Relay is built into Apple devices with iCloud+, and Zenarmor
       files its endpoints under Proxy: 629 of 978 evasion alerts in 7 days. A site
       that forbids it should block mask.icloud.com and mask-h2.icloud.com in DNS,
       which is Apple's documented way to turn it off for a network. -->
  <rule id="130825" level="2">
    <if_sid>130805,130806,130828</if_sid>
    <field name="zenarmor.domain" type="pcre2">(?i)^mask(-[a-z0-9]+)?\.icloud\.com$</field>
    <description>Zenarmor: Apple iCloud Private Relay connection - from: $(srcip) to: $(zenarmor.domain)</description>
    <options>no_full_log</options>
    <group>zenarmor,evasion,</group>
  </rule>

  <!-- check.torproject.org is a web page and the source of the Tor exit list that
       threat-intelligence tools download (measured: two log servers, once an hour
       each, 349 of 978 evasion alerts). Using Tor itself goes to relays, not here. -->
  <rule id="130826" level="2">
    <if_sid>130805,130806,130828</if_sid>
    <field name="zenarmor.domain" type="pcre2">(?i)^check\.torproject\.org$</field>
    <description>Zenarmor: Tor Project check page or exit list download - from: $(srcip)</description>
    <options>no_full_log</options>
    <group>zenarmor,evasion,</group>
  </rule>

  <!-- The site's own allowlist for the weak categories only (a corporate VPN
       endpoint filed under VPN, for example). It never silences malware or phishing. -->
  <rule id="130827" level="2">
    <if_sid>130805,130806,130828</if_sid>
    <list field="zenarmor.domain" lookup="match_key">etc/lists/jt-zenarmor-domain-allow</list>
    <description>Zenarmor: evasion-category connection to an allowlisted domain - from: $(srcip) to: $(zenarmor.domain)</description>
    <options>no_full_log</options>
    <group>zenarmor,evasion,</group>
  </rule>

  <!-- ===== Parked domains: recorded at level 0 ===== -->
  <!-- Measured 2026-08-30: very high false-positive rate. The classifier appears to
       key on the apex having no A record, which also describes CDN-fronted
       application backends (one client produced about 2,900 events a day). Real DGA
       activity carries Zenarmor's Botnet DGA Domains tag instead. -->
  <rule id="130807" level="0">
    <if_sid>130800</if_sid>
    <field name="security_tags" type="pcre2">(?i)^(?!.*(Malware|Virus|Botnet|C&amp;C|Command.?and.?Control|Ransomware|Trojan|Spyware|\bWorm\b|Phishing|Crypto.?Mining|Scam|Fraud|Spam|Hacking|Proxy|Anonymizer|\bTor\b|\bVPN\b|Compromised|Suspicious)).*Parked</field>
    <description>Zenarmor: connection to a parked domain - from: $(srcip) to: $(zenarmor.domain) $(dstip)</description>
    <options>no_full_log</options>
    <group>zenarmor,parked,</group>
  </rule>

  <rule id="130808" level="0">
    <if_sid>130800</if_sid>
    <field name="category" type="pcre2">(?i)Parked</field>
    <description>Zenarmor: connection to a parked domain - from: $(srcip) to: $(zenarmor.domain) $(dstip)</description>
    <options>no_full_log</options>
    <group>zenarmor,parked,</group>
  </rule>

  <!-- ===== Correlation ===== -->

  <!-- Unblocked malicious connections, one host. Several records per connection
       (conn, tls) are counted, so 6 is about two or three connections. -->
  <rule id="130830" level="13" frequency="6" timeframe="300">
    <if_matched_sid>130801</if_matched_sid>
    <same_field>ip_src_saddr</same_field>
    <description>[HIGH] Zenarmor: one internal host made repeated unblocked malicious connections in a short window, the host may be compromised: $(srcip)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,c2,</group>
  </rule>

  <!-- Blocked malicious connections, one host, sustained. One page view opens four
       to six connections at once (measured: 17 alert records in four minutes from
       one visit), so the threshold asks for a pattern over half an hour, which a
       program retrying every minute or two produces and a person browsing does not. -->
  <rule id="130831" level="10" frequency="20" timeframe="1800">
    <if_matched_sid>130802</if_matched_sid>
    <same_field>ip_src_saddr</same_field>
    <description>[WARN] Zenarmor: one internal host keeps retrying malicious connections, all blocked so far, check the host: $(srcip) last: $(zenarmor.domain)</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,blocked,</group>
  </rule>

  <!-- The same blocked threat name looked up again and again by one host: about one
       lookup every three minutes for an hour. Measured: mail-filter lookups of one
       name peaked at 24 an hour, so an unlisted resolver can still reach this. -->
  <rule id="130832" level="10" frequency="20" timeframe="3600">
    <if_matched_group>zenarmor_lookup_block</if_matched_group>
    <same_field>ip_src_saddr</same_field>
    <same_field>zenarmor.domain</same_field>
    <description>[WARN] Zenarmor: one host keeps looking up the same blocked threat domain, a sign of malware beaconing: $(srcip) $(zenarmor.domain) (if the host is a DNS resolver or mail filter, list it in jt-zenarmor-resolvers)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,c2,</group>
  </rule>

  <!-- Many different blocked threat names from one host within an hour: what DGA
       malware and a host with several infections look like. -->
  <rule id="130833" level="10" frequency="15" timeframe="3600">
    <if_matched_group>zenarmor_threat_block</if_matched_group>
    <same_field>ip_src_saddr</same_field>
    <different_field>zenarmor.domain</different_field>
    <description>[WARN] Zenarmor: one host was blocked from many different threat domains within an hour, possible infection or DGA: $(srcip) last: $(zenarmor.domain) (if the host is a DNS resolver or mail filter, list it in jt-zenarmor-resolvers)</description>
    <mitre>
      <id>T1568.002</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,c2,</group>
  </rule>

  <!-- A listed resolver asking for the same blocked threat name about once a minute
       for an hour: some client behind it is probably beaconing. The resolver's query
       log names the client. Measured peak for mail-filter traffic: 24 an hour. -->
  <rule id="130834" level="6" frequency="60" timeframe="3600">
    <if_matched_sid>130818</if_matched_sid>
    <same_field>ip_src_saddr</same_field>
    <same_field>zenarmor.domain</same_field>
    <description>Zenarmor: a resolver keeps looking up the same blocked threat domain for a client behind it, check its query log: $(zenarmor.domain) via: $(srcip)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <options>no_full_log</options>
    <group>zenarmor,malware,c2,dns,</group>
  </rule>

</group>
